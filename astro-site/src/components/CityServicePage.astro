---
import BaseLayout from '../layouts/BaseLayout.astro'
import FooterSocialIcon from './FooterSocialIcon.astro'
import FooterContactInfo from './FooterContactInfo.astro'
import FooterHoursRow from './FooterHoursRow.astro'
import FooterSmsDisclosure from './FooterSmsDisclosure.astro'
import FooterFinancingDisclosure from './FooterFinancingDisclosure.astro'
import FinancingBanner from './FinancingBanner.astro'
import SmsMarketingConsent from './SmsMarketingConsent.astro'
import { externalLinkAttrs } from '../lib/external-link.js'
import { googleBusinessProfileUrl, isContactFooterColumnHeading } from '../lib/footer-contact-heading.js'
import { mergeHeaderFromSettings } from '../lib/site-settings.js'
import { heroBackgroundFor } from '../lib/hero-backgrounds.js'
import { sanitizeCmsHtml } from '../lib/sanitize-cms-html.js'
import { asStr, applyTemplate, mediaUrl, statLookup } from '../lib/sanity-strings.js'
import {
  HOMEPAGE_SERVICE_AREA_HEADLINE,
  HOMEPAGE_SERVICE_AREA_INTRO,
  POPULAR_SERVICE_AREA_CITIES,
} from '../lib/service-area-cities.js'

/**
 * City service page renderer used by the root `/{slug}/` route.
 *
 * The parent page fetches the Sanity documents and passes them here to avoid
 * duplicate network requests.
 */
const { slug: slugProp, settings, homePage, cityPage } = Astro.props
const slug = asStr(slugProp)
const _settings = settings ?? {}
const _homePage = homePage ?? {}
const _cityPage = cityPage ?? {}
const pageDescription =
  asStr(_cityPage?.seoDescription) ||
  'Professional gutter services in Tampa with fast scheduling and quality workmanship.'

const business = _settings?.business ?? {}
const header = mergeHeaderFromSettings(_settings, _homePage?.header)
const hero = _homePage?.hero ?? {}
const services = _homePage?.services ?? {}
const faq = _cityPage?.faq ?? _homePage?.faq ?? {}
const footerEstimate = _settings?.footerEstimate ?? _homePage?.footerEstimate ?? {}
const footerEstimateFields = footerEstimate?.formFields ?? {}
const formsCfg = _settings?.forms ?? {}
const footerBrand = _settings?.footerBrand ?? _homePage?.footerBrand ?? {}
const footerColumns = _settings?.footerColumns ?? _homePage?.footerColumns ?? []
const footerSupport = _settings?.footerSupport ?? _homePage?.footerSupport ?? {}

const companyName = asStr(business.companyName) || 'SGT'
const phoneDisplay = asStr(business.phoneDisplay) || '(303) 000-0000'
const phoneTel = asStr(business.phoneTel) || '3030000000'
const email = asStr(business.email) || 'hello@example.com'
const address = asStr(business.addressShort) || 'Tampa, Colorado'
const addressHref = googleBusinessProfileUrl(settings)
const descriptionShort = asStr(business.descriptionShort)
const logoWhite = asStr(business.logoHorizontalWhite)
const copyrightHref = asStr(business.copyrightSiteUrl) || '#'
const logoBlack = asStr(business.logoHorizontalBlack)

const callLabelNav = applyTemplate(asStr(header.callCtaTemplate), { phoneDisplay }) || phoneDisplay
const logoAriaLabel = applyTemplate(asStr(header.logoAriaLabelTemplate), { companyName }) || companyName
const navItems = Array.isArray(header.navItems) ? header.navItems : []
const heroCallLabel = applyTemplate(asStr(hero?.callCtaTemplate), { phoneDisplay }) || `Call ${phoneDisplay}`
const universalFormFields = footerEstimateFields
const universalFormAction = asStr(formsCfg?.submitPath) || asStr(footerEstimate?.formAction) || '#'
const universalFormMethod = asStr(footerEstimate?.formMethod) || 'post'
const universalFormKicker = asStr(formsCfg?.formKicker) || 'Free Estimate'
const universalFormAriaLabel = asStr(formsCfg?.formAriaLabel) || 'City service lead form'
const universalRequiredIndicator = asStr(formsCfg?.requiredIndicator) || '*'
const universalFormHeading =
  asStr(_cityPage?.formHeading) || asStr(footerEstimate?.headline) || 'Get Started Today'
const universalFormIntro =
  asStr(_cityPage?.formIntro) ||
  asStr(footerEstimate?.intro) ||
  'Start with a free consultation and get honest recommendations and transparent pricing from a team Tampa Bay homeowners trust.'
const heroBgSrc = asStr(_cityPage?.layoutBackgrounds?.hero?.imageSrc) || heroBackgroundFor(`service-${slug}`)
const servicesBgSrc = asStr(_cityPage?.layoutBackgrounds?.services?.imageSrc)
const heroBgStyle = heroBgSrc
  ? `background-image: linear-gradient(135deg, rgba(56, 69, 85, 0.88) 0%, rgba(56, 69, 85, 0.84) 50%, rgba(56, 69, 85, 0.88) 100%), url("${mediaUrl(heroBgSrc)}"); background-size: cover; background-position: center; background-repeat: no-repeat;`
  : undefined
const servicesBgStyle = servicesBgSrc
  ? `background-color: #143980; background-image: linear-gradient(135deg, rgba(20, 57, 128, 0.94) 0%, rgba(26, 74, 158, 0.94) 100%), url("${mediaUrl(servicesBgSrc)}"); background-size: cover; background-position: center; background-repeat: no-repeat;`
  : undefined
const sharedReviews = _settings?.reviews ?? _homePage?.reviews ?? {}
const reviewsToRender = sharedReviews
const reviewValues = reviewsToRender?.reviewValues
const reviewSummary = reviewsToRender?.summary
const reviewRating = statLookup(reviewValues, reviewSummary?.ratingValueKey) || '4.9'
const reviewCount = statLookup(reviewValues, reviewSummary?.reviewCountKey) || '200'
const reviewCountDisplay = `${asStr(reviewSummary?.reviewCountPrefix) || '('}${reviewCount}${asStr(reviewSummary?.reviewCountSuffix) || ')'}`
const reviewsCtaHref = asStr(reviewSummary?.ctaHref) || '/reviews/'
const cityContentSections = Array.isArray(_cityPage?.contentSections) ? _cityPage.contentSections : []
const closingSection = _cityPage?.closingSection && typeof _cityPage.closingSection === 'object'
  ? _cityPage.closingSection
  : null
const hideServices = !!_cityPage?.hideServices
const mapEmbedUrl = asStr(_cityPage?.mapEmbedUrl) || asStr(_settings?.mapEmbedUrl)
const estimateCtaText = 'Book a Consultation'
const estimateCtaHref = '#contact'
const pageH1 = asStr(_cityPage?.headline) || asStr(hero?.headline) || 'Gutter Services in Tampa, FL'
const pageTitle = asStr(_cityPage?.title) || `${pageH1} | SunLife Gutters Tampa`

const sectionShowsCtas = (sec) => sec?.showCtas !== false
const sectionImageAfter = (sec) => asStr(sec?.imagePlacement).toLowerCase() === 'after'

const reviewsHeadline = 'What Tampa Bay Neighbors Say'
const reviewsBrandLabel = 'Google Rating Snapshot'
const serviceAreaEyebrow = asStr(_homePage?.serviceArea?.eyebrow) || 'Where We Travel'
const serviceAreaHeadline = HOMEPAGE_SERVICE_AREA_HEADLINE
const serviceAreaIntro = HOMEPAGE_SERVICE_AREA_INTRO
const serviceAreaCities = POPULAR_SERVICE_AREA_CITIES


const normalizeServiceCardHref = (href) => {
  const value = asStr(href).trim()
  if (!value) return ''
  const legacyMap = {
    '/seamless-gutters/': '/seamless-gutters-tampa-fl/',
    '/soffit-and-fascias/': '/soffit-fascia-repair-tampa-fl/',
    '/super-gutters/': '/super-gutters-tampa-fl/',
    '/screen-rooms-and-lanais/': '/screen-rooms-lanais-tampa-fl/',
    '/siding/': '/siding-tampa-fl/',
    '/underground-drainage/': '/underground-drainage-tampa-fl/',
  }
  return legacyMap[value] || value
}

const serviceHref = (svc) => {
  const explicit = normalizeServiceCardHref(svc?.href)
  if (explicit) return explicit
  const title = asStr(svc?.title).toLowerCase().trim()
  if (!title) return '/seamless-gutters-tampa-fl/'
  const knownSlugs = {
    'seamless gutters': 'seamless-gutters-tampa-fl',
    'soffit & fascia': 'soffit-fascia-repair-tampa-fl',
    'soffit and fascia': 'soffit-fascia-repair-tampa-fl',
    'super gutters': 'super-gutters-tampa-fl',
    'screen rooms & lanais': 'screen-rooms-lanais-tampa-fl',
    'screen rooms and lanais': 'screen-rooms-lanais-tampa-fl',
    siding: 'siding-tampa-fl',
    'underground drainage': 'underground-drainage-tampa-fl',
    'french drains': 'french-drains-tampa-fl',
  }
  if (knownSlugs[title]) return `/${knownSlugs[title]}/`
  const generated = title
    .replace(/&/g, ' and ')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '')
  return `/${generated}/`
}
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  theme={settings?.theme}
  forms={{ submitPath: asStr(settings?.forms?.submitPath) || '/api/lead' }}
>
  <header class="header">
    <div class="offer-bar">
      <div class="offer-bar-inner">
        <p class="offer-message">
          {asStr(header?.offerBar?.textBeforeDiscount)}
          <strong>{asStr(header?.offerBar?.discountLabel)}</strong>
          {asStr(header?.offerBar?.textAfterDiscount)}
          <a
            href={asStr(header?.offerBar?.ctaHref) || '#contact'}
            class="offer-link"
            {...externalLinkAttrs(asStr(header?.offerBar?.ctaHref) || '#contact')}
          >
            <strong>{asStr(header?.offerBar?.ctaText) || 'Get a Quote Now!'}</strong>
          </a>
        </p>
      </div>
    </div>
    <div class="header-nav">
      <div class="header-inner">
        <a href="/" class="logo" aria-label={logoAriaLabel}>
          {logoBlack ? (
            <img src={mediaUrl(logoBlack)} alt={companyName} class="logo-img" />
          ) : (
            <span class="section-title" style="margin:0; font-size: 1.25rem;">{companyName}</span>
          )}
        </a>
        <button class="nav-toggle" aria-label="Open menu">
          <span></span><span></span><span></span>
        </button>
        <nav class="nav">
          {navItems.length > 0 ? (
            navItems.map((item, i) => {
              const label = asStr(item.label)
              const href = asStr(item.href)
              const dropdown = item.dropdown
              if (Array.isArray(dropdown) && dropdown.length > 0) {
                const ddId = `city-nav-dd-${i}`
                return (
                  <div class="nav-dropdown" data-nav-dropdown>
                    <button
                      type="button"
                      class="nav-dropdown-toggle"
                      aria-expanded="false"
                      aria-haspopup="true"
                      aria-controls={ddId}
                      id={`${ddId}-btn`}
                    >
                      {label}
                      <span class="nav-dropdown-chevron" aria-hidden="true"></span>
                    </button>
                    <ul class="nav-dropdown-menu" id={ddId} role="menu">
                      {dropdown.map((link) => (
                        <li role="none">
                          <a href={asStr(link.href)} role="menuitem" {...externalLinkAttrs(asStr(link.href))}>
                            {asStr(link.label)}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                )
              }
              return (
                <a href={href || '#'} {...externalLinkAttrs(href || '')}>
                  {label}
                </a>
              )
            })
          ) : (
            <>
              <a href="/">Home</a>
              <a href="/seamless-gutters-tampa-fl/">Products & Services</a>
            </>
          )}
          <a href={`tel:${phoneTel}`} class="btn btn-primary btn-lg">{callLabelNav}</a>
        </nav>
      </div>
    </div>
  </header>

  <main>
    <section class="hero hero-split">
      <div class="hero-bg" style={heroBgStyle}></div>
      <div class="container hero-split-inner">
        <div class="hero-copy">
          <div class="hero-eyebrow">{asStr(_cityPage?.eyebrow) || asStr(hero?.eyebrow) || 'City Service'}</div>
          <h1>{pageH1}</h1>
          <p class="hero-lead">{asStr(_cityPage?.lead) || asStr(hero?.lead) || 'City service page starter connected to Sanity content.'}</p>
          <div class="hero-actions">
            <a href={`tel:${phoneTel}`} class="btn btn-primary btn-lg cta1-primary-call">{heroCallLabel}</a>
          </div>
        </div>

        <form
          class="hero-form"
          data-lead-form="city-hero"
          action={universalFormAction}
          method={universalFormMethod}
          aria-label={universalFormAriaLabel}
        >
          <div class="hero-form-heading">
            <div class="hero-form-kicker">{universalFormKicker}</div>
            <h2>{universalFormHeading}</h2>
          </div>
          <p class="hero-form-sub">{universalFormIntro}</p>
          <div class="hero-form-grid">
            <div class="hero-form-field">
              <label for="name">
                {asStr(universalFormFields?.nameLabel) || 'Name'}{' '}
                <span class="required-mark" aria-hidden="true">{universalRequiredIndicator}</span>
              </label>
              <input id="name" name="name" type="text" required autocomplete="name" />
            </div>
            <div class="hero-form-field">
              <label for="email">
                {asStr(universalFormFields?.emailLabel) || 'Email'}{' '}
                <span class="required-mark" aria-hidden="true">{universalRequiredIndicator}</span>
              </label>
              <input id="email" name="email" type="email" required autocomplete="email" />
            </div>
            <div class="hero-form-field">
              <label for="phone">
                {asStr(universalFormFields?.phoneLabel) || 'Phone'}{' '}
                <span class="required-mark" aria-hidden="true">{universalRequiredIndicator}</span>
              </label>
              <input id="phone" name="phone" type="tel" required autocomplete="tel" />
            </div>
            <div class="hero-form-field">
              <label for="location">{asStr(universalFormFields?.cityLabel) || 'City'}</label>
              <input id="location" name="location" type="text" autocomplete="address-level2" />
            </div>
            <div class="hero-form-field hero-form-field-full">
              <label for="message">{asStr(universalFormFields?.projectDetailsLabel) || 'Project Details'}</label>
              <textarea id="message" name="message" rows="3"></textarea>
            </div>
          </div>
          <SmsMarketingConsent checkboxId="city-hero-sms-consent" />
          <button type="submit" class="btn btn-primary btn-lg">Submit</button>
        </form>
      </div>
    </section>

    <FinancingBanner phoneDisplay={phoneDisplay} phoneTel={phoneTel} />

    <section class="section city-service-content">
      <div class="container">
        <article class="city-service-article">
          {(cityContentSections.length > 0
            ? cityContentSections
            : [
                {
                  heading: 'Service details',
                  body: 'Add one or more content blocks for this page in Sanity (city service → content sections). Images are optional per block.',
                },
              ]
          ).map((sec) => (
            <div class="city-service-block">
              {!sectionImageAfter(sec) && asStr(sec.imageSrc) ? (
                <img
                  src={mediaUrl(asStr(sec.imageSrc))}
                  alt={asStr(sec.imageAlt) || asStr(sec.heading)}
                  class="city-service-section-image"
                  width="1200"
                  height="800"
                  loading="lazy"
                  decoding="async"
                />
              ) : null}
              <h2 class="section-title section-title-secondary">{asStr(sec.heading)}</h2>
              <div
                class="city-service-body"
                set:html={sanitizeCmsHtml(asStr(sec.body))}
              />
              {sectionImageAfter(sec) && asStr(sec.imageSrc) ? (
                <img
                  src={mediaUrl(asStr(sec.imageSrc))}
                  alt={asStr(sec.imageAlt) || asStr(sec.heading)}
                  class="city-service-section-image city-service-section-image--after"
                  width="1200"
                  height="800"
                  loading="lazy"
                  decoding="async"
                />
              ) : null}
              {sectionShowsCtas(sec) ? (
                <div class="why-choose-actions city-service-ctas">
                  <a href={`tel:${phoneTel}`} class="btn btn-primary btn-lg">{heroCallLabel}</a>
                  <a
                    href={estimateCtaHref}
                    class="btn btn-outline btn-lg request-estimate"
                    {...externalLinkAttrs(estimateCtaHref)}
                  >
                    {estimateCtaText}
                  </a>
                </div>
              ) : null}
            </div>
          ))}
        </article>
      </div>
    </section>

    {!hideServices ? (
    <section class="section services" style={servicesBgStyle}>
      <div class="container">
        <h2 class="section-title">{asStr(services?.headline) || 'Our Gutter Services in Tampa'}</h2>
        <div class="services-grid">
          {(Array.isArray(services?.items) && services.items.length > 0
            ? services.items
            : [
                { number: '01', title: 'Gutter Installation', description: 'Placeholder text for service summary.' },
                { number: '02', title: 'Gutter Repair', description: 'Placeholder text for service summary.' },
                { number: '03', title: 'Gutter Guards', description: 'Placeholder text for service summary.' },
              ]
          ).map((svc) => (
            <article class="service-card">
              <a href={serviceHref(svc)} class="service-image-wrap" style="display:block; color:inherit; text-decoration:none;">
                <span class="service-number">{asStr(svc.number)}</span>
                <h3 class="service-title">{asStr(svc.title)}</h3>
                <p class="service-desc">{asStr(svc.description)}</p>
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>
    ) : null}

    <section class="section faq-section" id="faq">
      <div class="container">
        <div class="faq-panel">
          <h2 class="section-title section-title-secondary" id={asStr(faq?.headingId) || 'city-faq-heading'}>
            {asStr(faq?.headline) || 'Frequently Asked Questions'}
          </h2>
          <div class="faq-list" data-faq-accordion>
            {(Array.isArray(faq?.items) && faq.items.length > 0
              ? faq.items
              : [
                  {
                    question: 'How long does installation take?',
                    answerHtml: '<p>Most projects are completed in one day depending on roof size and complexity.</p>',
                  },
                ]
            ).slice(0, 8).map((item, idx) => {
              const n = idx + 1
              const btnId = `city-faq-btn-${n}`
              const panelId = `city-faq-panel-${n}`
              return (
                <div class="faq-item">
                  <button
                    type="button"
                    class="faq-summary"
                    id={btnId}
                    aria-expanded="false"
                    aria-controls={panelId}
                  >
                    <span class="faq-question">{asStr(item.question)}</span>
                    <span class="faq-chevron" aria-hidden="true"></span>
                  </button>
                  <div
                    class="faq-answer-outer"
                    id={panelId}
                    role="region"
                    aria-labelledby={btnId}
                    aria-hidden="true"
                  >
                    <div class="faq-answer" set:html={sanitizeCmsHtml(asStr(item.answerHtml))} />
                  </div>
                </div>
              )
            })}
          </div>
        </div>
      </div>
    </section>

    <section class="section google-reviews">
      <div class="container">
        <h2 class="section-title reviews-title">{reviewsHeadline}</h2>
        <div class="reviews-summary">
          <div class="reviews-summary-left">
            <p class="reviews-summary-brand">
              <img
                src={mediaUrl(asStr(reviewSummary?.googleIconSrc))}
                alt={reviewsBrandLabel}
                class="google-logo"
                width="20"
                height="20"
                loading="lazy"
                decoding="async"
              />
              <span>{reviewsBrandLabel}</span>
            </p>
            <p class="reviews-summary-rating">
              <strong>{reviewRating}</strong>
              <img
                src={mediaUrl(asStr(reviewSummary?.starsImageSrc))}
                alt={asStr(reviewSummary?.starsImageAlt) || '5 star rating'}
                class="review-stars review-stars-inline"
                width="96"
                height="18"
                loading="lazy"
                decoding="async"
              />
              <span>{reviewCountDisplay}</span>
            </p>
          </div>
          <a
            href={reviewsCtaHref}
            class="btn btn-outline btn-lg request-estimate reviews-summary-cta"
            {...externalLinkAttrs(reviewsCtaHref)}
          >
            {asStr(reviewSummary?.ctaText) || 'See More Reviews'}
          </a>
        </div>
        <div class="testimonials-grid">
          {(Array.isArray(reviewsToRender?.testimonials) ? reviewsToRender.testimonials : []).slice(0, 4).map((t) => (
            <blockquote class="testimonial">
              <div class="review-brand review-brand-top">
                <img src={mediaUrl(asStr(t.avatarSrc))} alt={asStr(t.author)} class="review-avatar" />
                <div class="review-meta">
                  <strong>{asStr(t.author)}</strong>
                  <span class="review-time">{asStr(t.timeAgo)}</span>
                </div>
              </div>
              <img
                src={mediaUrl(asStr(reviewsToRender?.summary?.starsImageSrc))}
                alt={asStr(reviewsToRender?.summary?.starsImageAlt)}
                class="review-stars"
              />
              <p>&quot;{asStr(t.quote)}&quot;</p>
            </blockquote>
          ))}
        </div>
      </div>
    </section>

    {closingSection ? (
      <section class="section city-service-closing">
        <div class="container">
          <article class="city-service-article">
            <div class="city-service-block">
              <h2 class="section-title section-title-secondary">{asStr(closingSection.heading)}</h2>
              <div
                class="city-service-body"
                set:html={sanitizeCmsHtml(asStr(closingSection.body))}
              />
              {sectionShowsCtas(closingSection) ? (
                <div class="why-choose-actions city-service-ctas">
                  <a href={`tel:${phoneTel}`} class="btn btn-primary btn-lg">{heroCallLabel}</a>
                  <a
                    href={estimateCtaHref}
                    class="btn btn-outline btn-lg request-estimate"
                    {...externalLinkAttrs(estimateCtaHref)}
                  >
                    {estimateCtaText}
                  </a>
                </div>
              ) : null}
            </div>
          </article>
        </div>
      </section>
    ) : null}

    <section class="section service-area city-service-map" id="city-map">
      <div class="container">
        <div class="why-eyebrow">{serviceAreaEyebrow}</div>
        <h2 class="section-title">{serviceAreaHeadline}</h2>
        <p class="section-lead service-area-intro">{serviceAreaIntro}</p>
        <div class="service-area-grid service-area-grid--stacked">
          <div class="map-wrap">
            <iframe
              src={mapEmbedUrl}
              width="600"
              height="400"
              style="border:0;"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title={`${companyName} service area map`}
            ></iframe>
          </div>
          <div class="cities-list cities-list--pills">
            <p class="cities-label">Popular service areas</p>
            <nav class="cities-nav cities-nav--pills" aria-label="Cities we serve">
              {serviceAreaCities.map((c) => (
                <a href={asStr(c.href)} {...externalLinkAttrs(asStr(c.href))}>
                  {asStr(c.name)}
                </a>
              ))}
            </nav>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <section id="contact" class="section contact footer-estimate">
      <div class="container">
        <div class="contact-wrapper">
          <div class="contact-info">
            <h2 class="section-title">{universalFormHeading}</h2>
            <p>{universalFormIntro}</p>
            <FooterContactInfo
              variant="estimate"
              phoneTel={phoneTel}
              phoneDisplay={phoneDisplay}
              email={email}
              address={address}
              addressHref={addressHref}
            />
          </div>
          <form
            class="contact-form"
            data-lead-form="city-footer"
            action={universalFormAction}
            method={universalFormMethod}
          >
            <div class="contact-form-grid">
              <div class="contact-form-field">
                <label for="contact-name">
                  {asStr(universalFormFields?.nameLabel) || 'Name'}{' '}
                  <span class="required-mark" aria-hidden="true">{universalRequiredIndicator}</span>
                </label>
                <input id="contact-name" name="name" type="text" required autocomplete="name" />
              </div>
              <div class="contact-form-field">
                <label for="contact-email">
                  {asStr(universalFormFields?.emailLabel) || 'Email'}{' '}
                  <span class="required-mark" aria-hidden="true">{universalRequiredIndicator}</span>
                </label>
                <input id="contact-email" name="email" type="email" required autocomplete="email" />
              </div>
              <div class="contact-form-field">
                <label for="contact-phone">
                  {asStr(universalFormFields?.phoneLabel) || 'Phone'}{' '}
                  <span class="required-mark" aria-hidden="true">{universalRequiredIndicator}</span>
                </label>
                <input id="contact-phone" name="phone" type="tel" required autocomplete="tel" />
              </div>
              <div class="contact-form-field">
                <label for="contact-location">{asStr(universalFormFields?.cityLabel) || 'City'}</label>
                <input id="contact-location" name="location" type="text" autocomplete="address-level2" />
              </div>
              <div class="contact-form-field contact-form-field-full">
                <label for="contact-message">{asStr(universalFormFields?.projectDetailsLabel) || 'Project Details'}</label>
                <textarea id="contact-message" name="message" rows="4"></textarea>
              </div>
            </div>
            <SmsMarketingConsent checkboxId="city-footer-sms-consent" />
            <button type="submit" class="btn btn-primary btn-lg">Submit</button>
          </form>
        </div>
      </div>
    </section>
    <div class="container">
      <div class="footer-inner">
        <div class="footer-brand-block footer-col">
          {logoWhite ? <img src={mediaUrl(logoWhite)} alt={companyName} class="footer-logo" /> : null}
          <p class="footer-address">{descriptionShort}</p>
          <div class="footer-social" aria-label={asStr(footerBrand?.socialAriaLabel)}>
            {footerBrand?.socialLinks?.map((s) => (
              <a href={asStr(s.href)} aria-label={asStr(s.ariaLabel)} {...externalLinkAttrs(asStr(s.href))}>
                <FooterSocialIcon platform={asStr(s.platform)} />
              </a>
            ))}
          </div>
        </div>
        {footerColumns?.map((col) => (
          <div class="footer-col">
            <p class="footer-heading">{asStr(col.heading)}</p>
            {col.links?.length ? (
              <nav class="footer-links" aria-label={asStr(col.ariaLabel)}>
                {col.links.map((link) => (
                  <a href={asStr(link.href)} {...externalLinkAttrs(asStr(link.href))}>
                    {asStr(link.label)}
                  </a>
                ))}
              </nav>
            ) : null}
            {isContactFooterColumnHeading(col.heading) ? (
              <FooterContactInfo
                variant="footer-column"
                phoneTel={phoneTel}
                phoneDisplay={phoneDisplay}
                email={email}
                address={address}
                addressHref={addressHref}
              />
            ) : null}
            {col.hoursHeading ? <p class="footer-heading footer-hours-heading">{asStr(col.hoursHeading)}</p> : null}
            {col.hoursText ? <FooterHoursRow hoursText={col.hoursText} /> : null}
            {(col.hoursHeading || col.hoursText) ? <FooterSmsDisclosure /> : null}
          </div>
        ))}
      </div>
    </div>
  </footer>

  <FooterFinancingDisclosure />

  <div class="footer-support">
    <div class="container footer-support-inner">
      <p>
        © <span id="year"></span> —{' '}
        <a href={copyrightHref} {...externalLinkAttrs(copyrightHref)}>
          {companyName}
        </a>
      </p>
      <nav aria-label={asStr(footerSupport?.ariaLabel)}>
        {footerSupport?.links?.map((link) => (
          <a href={asStr(link.href)} {...externalLinkAttrs(asStr(link.href))}>
            {asStr(link.label)}
          </a>
        ))}
      </nav>
    </div>
  </div>
</BaseLayout>
