  (Array.isArray(projects?.slides) ? projects.slides : [])

/** LP-specific Google reviews (carousel pages of 4). */
const lpReviewsBySlug = {
  'gutter-guards': gutterGuardsReviews,
  'gutter-installation': gutterInstallationReviews,
  'gutter-repair': gutterRepairReviews,
