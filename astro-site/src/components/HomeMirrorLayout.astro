const lpCity = cityFromHeroOrFallback(hero?.headline, address)

const lpSeasonCopy = (value) => {
  if (!isLp) return asStr(value)
  return asStr(value).replace(/\bSpring\b/gi, 'Summer')
}

const lpHeroHeadlinesBySlug = {
