    : []
  : homepageWhyChoose.bullets
const whyChooseNote = isLp ? asStr(whyChoose?.note) : homepageWhyChoose.note
const servicesHeadline = isLp ? 'More Gutter Services' : homepageHeadlines.services
const servicesItems = isLp
