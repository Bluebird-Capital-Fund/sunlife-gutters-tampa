            <span id="hero-typed-text"></span><span class="hero-caret" aria-hidden="true">|</span>
          </p>
          <ul class="hero-lead hero-lead-list">
            <li>
              <strong>10,000+</strong> projects completed
            </li>
            <li>
              <strong>7+ years</strong> serving Tampa Bay
            </li>
            <li>
              <strong>4.9-star Google rating</strong> from <strong>247 reviews</strong>
            </li>
            <li>
              <strong>Family-owned business</strong> based in Seffner
            </li>
            <li>
              <strong>Lifetime warranty options</strong> available*
            </li>
            <li>
              <strong>Flexible financing</strong> available
            </li>
            <li>
              <strong>Clear communication</strong> from estimate to installation
            </li>
          </ul>
          <div class="hero-actions">
            <a href={telLink} class="btn btn-primary btn-lg cta1-primary-call">{callLabelHero}</a>
          </div>
        </div>
        <form
          class="hero-form"
          data-lead-form={heroLeadFormAttr}
          action={universalFormAction}
          method={universalFormMethod}
          aria-label={universalFormAriaLabel}
        >
          <div class="hero-form-heading">
            {showHeroFormKicker ? <div class="hero-form-kicker">{universalFormKicker}</div> : null}
            <h2>{lpFormMainHeading}</h2>
          </div>
          <p class="hero-form-sub">{universalFormIntro}</p>
          <div class="hero-form-grid">
            <div class="hero-form-field">
              <label for={heroNameId}>
                {asStr(universalFormFields?.nameLabel) || 'Name'}{' '}
                <span class="required-mark" aria-hidden="true">{universalRequiredIndicator}</span>
              </label>
              <input id={heroNameId} name="name" type="text" required autocomplete="name" />
            </div>
            <div class="hero-form-field">
              <label for={heroEmailId}>
                {asStr(universalFormFields?.emailLabel) || 'Email'}{' '}
                <span class="required-mark" aria-hidden="true">{universalRequiredIndicator}</span>
              </label>
              <input id={heroEmailId} name="email" type="email" required autocomplete="email" />
            </div>
            <div class="hero-form-field">
              <label for={heroPhoneId}>
                {asStr(universalFormFields?.phoneLabel) || 'Phone'}{' '}
                <span class="required-mark" aria-hidden="true">{universalRequiredIndicator}</span>
              </label>
              <input id={heroPhoneId} name="phone" type="tel" required autocomplete="tel" />
            </div>
            <div class="hero-form-field">
              <label for={heroLocationId}>{asStr(universalFormFields?.cityLabel) || 'City'}</label>
              <input id={heroLocationId} name="location" type="text" autocomplete="address-level2" />
            </div>
            <div class="hero-form-field hero-form-field-full">
              <label for={heroMessageId}>
                {asStr(universalFormFields?.projectDetailsLabel) || 'Project Details'}
              </label>
              <textarea id={heroMessageId} name="message" rows="3"></textarea>
            </div>
          </div>
          <SmsMarketingConsent checkboxId={heroSmsConsentId} />
          <div class="lead-form-honeypot-wrap" aria-hidden="true">
            <label for={heroWebsiteId}>Leave blank</label>
            <input type="text" id={heroWebsiteId} name="website" tabindex="-1" autocomplete="off" />
          </div>
          <p class="lead-form-status" data-lead-form-status role="status" aria-live="polite"></p>
          <button type="submit" class="btn btn-primary btn-lg">{universalSubmitLabel}</button>
        </form>
      </div>
      <section class="brands-marquee" aria-label={asStr(brandsMarquee?.ariaLabel)}>
        <div class="brands-track">
          <div class="brands-inner">
            {[0, 1, 2].map((idx) => (
              <div class="brands-group" aria-hidden={idx > 0 ? 'true' : undefined}>
                {asStrArray(brandsMarquee?.brands).map((b) => (
                  <span class="brand-pill">{b}</span>
