  ? `What Tampa Bay Homeowners Say About Our ${lpKeyword}`
  : 'What Tampa Bay Neighbors Say'
const reviewsBrandLabelDisplay = 'Google Rating Snapshot'
const projectsHeadline = isLp ? `Recent ${lpKeyword} Projects` : homepageHeadlines.projects
const whyChooseHeadline = isLp
