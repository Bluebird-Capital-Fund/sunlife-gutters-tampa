          >
            {asStr(reviewsSummary?.ctaText)}
          </a>
        </div>

        {useLpReviewsCarousel ? (
          <div class="reviews-carousel" id="reviews-carousel">
            {reviewCarouselPages.map((page, pageIndex) => (
              <div
                class:list={['reviews-carousel-page', 'testimonials-grid', { 'is-active': pageIndex === 0 }]}
                data-page={pageIndex}
                aria-hidden={pageIndex === 0 ? 'false' : 'true'}
              >
                {page.map((t) => (
                  <blockquote class="testimonial">
                    <div class="review-brand review-brand-top">
                      <img
                        src={mediaUrl(asStr(t.avatarSrc))}
                        alt={asStr(t.author)}
                        class="review-avatar"
                        width="48"
                        height="48"
                        loading="lazy"
                        decoding="async"
                      />
                      <div class="review-meta">
                        <strong>{asStr(t.author)}</strong>
                        {asStr(t.timeAgo) ? <span class="review-time">{asStr(t.timeAgo)}</span> : null}
                      </div>
                    </div>
                    <img
                      src={mediaUrl(asStr(reviewsSummary?.starsImageSrc))}
                      alt={asStr(reviewsSummary?.starsImageAlt)}
