const lpReviewItems = isLp ? lpReviewsBySlug[lpSlug] || lpReviewsBySlug[lpAssetSlug] : null
const useLpReviewsCarousel = Array.isArray(lpReviewItems) && lpReviewItems.length > 0
const reviewCarouselPages = useLpReviewsCarousel ? chunkReviews(lpReviewItems, 4) : []
const homepageTestimonials = Array.isArray(reviews?.testimonials) ? reviews.testimonials : []
const homepageHeadlines = {
  reviews: 'Our Tampa Gutter Company Reviews',
  projects: 'Recent Gutter Work Throughout Tampa & Surrounding Areas',
  whyChoose: 'The Trusted Local Choice for Gutters in Tampa Bay',
