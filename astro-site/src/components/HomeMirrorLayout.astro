---
import BaseLayout from '../layouts/BaseLayout.astro'
import UniquePointIcon from './UniquePointIcon.astro'
import FooterSocialIcon from './FooterSocialIcon.astro'
import FooterContactInfo from './FooterContactInfo.astro'
import FooterHoursRow from './FooterHoursRow.astro'
import FooterSmsDisclosure from './FooterSmsDisclosure.astro'
import SmsMarketingConsent from './SmsMarketingConsent.astro'
import { externalLinkAttrs } from '../lib/external-link.js'
import { googleBusinessProfileUrl, isContactFooterColumnHeading } from '../lib/footer-contact-heading.js'
import { getSiteSettings, getHomePage, mergeHeaderFromSettings } from '../lib/site-settings.js'
import {
  asStr,
  asStrArray,
  applyTemplate,
  escapeHtml,
  mediaUrl,
  statLookup,
} from '../lib/sanity-strings.js'
import { assertSanityHomepage } from '../lib/assert-sanity-homepage.js'
import { sanitizeCmsHtml } from '../lib/sanitize-cms-html.js'
import { cityFromHeroOrFallback } from '../lib/extract-lp-city.js'
import { gutterGuardsReviews, chunkReviews } from '../lib/lp-gutter-guards-reviews.js'
import { gutterInstallationReviews } from '../lib/lp-gutter-installation-reviews.js'
import { gutterRepairReviews } from '../lib/lp-gutter-repair-reviews.js'

interface Props {
  lp?: { slug: string; keyword: string }
}

const { lp } = Astro.props

const [settings, homePage] = await Promise.all([getSiteSettings(), getHomePage()])

assertSanityHomepage(settings, homePage)

const business = settings.business
const meta = settings.meta
const statsValues = settings.statsValues
const mapEmbedUrl = asStr(settings.mapEmbedUrl)

/** Public-facing business name on the home page (header, footer, templates). */
const companyName = 'SunLife Gutters Tampa'
const phoneDisplay = asStr(business?.phoneDisplay)
const tel = asStr(business?.phoneTel)
const email = asStr(business?.email)
const address = asStr(business?.addressShort)
const addressHref = googleBusinessProfileUrl(settings)
const descriptionShort = asStr(business?.descriptionShort)
const copyrightHref = asStr(business?.copyrightSiteUrl)
const logoBlack = asStr(business?.logoHorizontalBlack)
const logoWhite = asStr(business?.logoHorizontalWhite)

const pageTitle = asStr(meta?.title)
const pageDescription = asStr(meta?.description)

const hp = homePage
const header = mergeHeaderFromSettings(settings, hp.header)
const offerBar = header?.offerBar
const navItems = header?.navItems
const hero = hp.hero
const brandsMarquee = hp.brandsMarquee
const projects = hp.projects
const whyChoose = hp.whyChoose
const whyStamp = whyChoose?.stamp
const whyCtas = whyChoose?.ctas
const services = hp.services
const about = hp.about
const aboutVideo = about?.video
const uniquePoints = hp.uniquePoints
const statsBar = hp.statsBar
const contactBanner = hp.contactBanner
const reviews = settings?.reviews ?? hp.reviews
const reviewsSummary = reviews?.summary
const reviewValues = reviews?.reviewValues
const serviceArea = hp.serviceArea
const team = hp.team
const faq = hp.faq
const footerEstimate = settings?.footerEstimate ?? hp.footerEstimate
const footerEstimateFields = footerEstimate?.formFields
const footerBrand = settings?.footerBrand ?? hp.footerBrand
const footerColumns = settings?.footerColumns ?? hp.footerColumns
const footerSupport = settings?.footerSupport ?? hp.footerSupport
const formsCfg = settings?.forms ?? {}

const reviewRating = statLookup(reviewValues, reviewsSummary?.ratingValueKey)
const reviewCount = statLookup(reviewValues, reviewsSummary?.reviewCountKey)
const reviewCountDisplay = `${asStr(reviewsSummary?.reviewCountPrefix)}${reviewCount}${asStr(reviewsSummary?.reviewCountSuffix)}`
const reviewsCtaHref = asStr(reviewsSummary?.ctaHref) || '/reviews/'

const callLabelNav = applyTemplate(asStr(header?.callCtaTemplate), {
  phoneDisplay,
})
const callLabelHero = applyTemplate(asStr(hero?.callCtaTemplate), {
  phoneDisplay,
})
const logoAriaLabel = applyTemplate(asStr(header?.logoAriaLabelTemplate), {
  companyName,
})

const telLink = `tel:${tel}`

const homesCountDisplay = applyTemplate(asStr(whyStamp?.homesCountTemplate), {
  count: statLookup(statsValues, whyStamp?.homesCountKey),
})

const whyCallLabel = applyTemplate(asStr(whyCtas?.callTemplate), {
  phoneDisplay,
})
const aboutCallLabel = applyTemplate(asStr(about?.ctas?.callTemplate), {
  phoneDisplay,
})

const mapIframeTitle = applyTemplate(asStr(serviceArea?.mapIframeTitleTemplate), {
  companyName,
})

const layoutBg = hp.layoutBackgrounds
const heroBgSrcDefault = asStr(layoutBg?.hero?.imageSrc)
const servicesBgSrcDefault = asStr(layoutBg?.services?.imageSrc)
const uniquePointsBgSrcDefault = asStr(layoutBg?.uniquePoints?.imageSrc)
const whyChooseImageSrcDefault = asStr(whyChoose?.imageSrc)
const aboutVisualImageSrcDefault = ''

const typedPhrases = [
  'Norandex',
  'Spectra Gutter Systems',
  'LeafBlaster Pro',
  'ABC Supply Co. Inc',
  'Senox',
]

const copyrightTemplate = asStr(footerSupport?.copyrightTemplate)
const copyrightInnerHtml = sanitizeCmsHtml(
  copyrightTemplate
    .replace(/\{\{\s*year\s*\}\}/gi, '<span id="year"></span>')
    .replace(/\{\{\s*companyName\s*\}\}/gi, escapeHtml(companyName))
)

const universalFormFields = footerEstimateFields
const universalFormAction = asStr(formsCfg?.submitPath) || asStr(footerEstimate?.formAction)
const universalFormMethod = asStr(footerEstimate?.formMethod) || 'post'
const universalFormHeading = asStr(footerEstimate?.headline)
const universalFormIntro = asStr(footerEstimate?.intro)
const universalSubmitLabel = asStr(footerEstimateFields?.submitButton)
const universalFormKicker = asStr(formsCfg?.formKicker) || 'Free Estimate'
const universalFormAriaLabel = asStr(formsCfg?.formAriaLabel) || 'Lead form'
const universalRequiredIndicator = asStr(formsCfg?.requiredIndicator) || '*'

const lpKeyword = (lp?.keyword && String(lp.keyword).trim()) || ''
const lpSlug = (lp?.slug && String(lp.slug).trim()) || ''
const isLp = !!(lp && lpKeyword && lpSlug)

/** LP-only section imagery overrides (hero / difference / services / about / unique points). */
const lpSectionImagesBySlug = {
  'gutter-guards': {
    hero: 'Media (SGT)/Images (SGT)/sunlife-gutters-tampa-gutter-guards-lp-hero.png',
    difference: 'Media (SGT)/Images (SGT)/sunlife-gutters-tampa-gutter-guards-lp-difference.png',
    services: 'Media (SGT)/Images (SGT)/sunlife-gutters-tampa-gutter-guards-lp-services.png',
    about: 'Media (SGT)/Images (SGT)/sunlife-gutters-tampa-gutter-guards-lp-about.png',
    uniquePoints: 'Media (SGT)/Images (SGT)/sunlife-gutters-tampa-gutter-guards-lp-unique-points.png',
  },
  'gutter-repair': {
    hero: 'Media (SGT)/Images (SGT)/sunlife-gutters-tampa-gutter-repair-lp-hero.png',
    difference: 'Media (SGT)/Images (SGT)/sunlife-gutters-tampa-gutter-repair-lp-difference.png',
    services: 'Media (SGT)/Images (SGT)/sunlife-gutters-tampa-gutter-repair-lp-services.png',
    about: 'Media (SGT)/Images (SGT)/sunlife-gutters-tampa-gutter-repair-lp-about.png',
    uniquePoints: 'Media (SGT)/Images (SGT)/sunlife-gutters-tampa-gutter-repair-lp-unique-points.png',
  },
  'gutter-installation': {
    hero: 'Media (SGT)/Images (SGT)/sunlife-gutters-tampa-gutter-installation-lp-hero.png',
    difference: 'Media (SGT)/Images (SGT)/sunlife-gutters-tampa-gutter-installation-lp-difference.png',
    services: 'Media (SGT)/Images (SGT)/sunlife-gutters-tampa-gutter-installation-lp-services.png',
    about: 'Media (SGT)/Images (SGT)/sunlife-gutters-tampa-gutter-installation-lp-about.png',
    uniquePoints: 'Media (SGT)/Images (SGT)/sunlife-gutters-tampa-gutter-installation-lp-unique-points.png',
  },
}
const lpSectionImages = isLp ? lpSectionImagesBySlug[lpSlug] : null

const heroBgSrc = asStr(lpSectionImages?.hero) || heroBgSrcDefault
const servicesBgSrc = asStr(lpSectionImages?.services) || servicesBgSrcDefault
const uniquePointsBgSrc = asStr(lpSectionImages?.uniquePoints) || uniquePointsBgSrcDefault
const whyChooseImageSrc = asStr(lpSectionImages?.difference) || whyChooseImageSrcDefault
const aboutVisualImageSrc = asStr(lpSectionImages?.about) || aboutVisualImageSrcDefault
const useAboutImage = aboutVisualImageSrc.trim() !== ''

const heroBgStyle = `background-image: linear-gradient(135deg, rgba(56, 69, 85, 0.88) 0%, rgba(56, 69, 85, 0.84) 50%, rgba(56, 69, 85, 0.88) 100%), url("${mediaUrl(heroBgSrc)}"); background-size: cover; background-position: center; background-repeat: no-repeat;`

const servicesBgStyle = `background-color: #143980; background-image: linear-gradient(135deg, rgba(20, 57, 128, 0.94) 0%, rgba(26, 74, 158, 0.94) 100%), url("${mediaUrl(servicesBgSrc)}"); background-size: cover; background-position: center; background-repeat: no-repeat;`

const uniquePointsBgStyle = `background: var(--color-surface); background-image: url("${mediaUrl(uniquePointsBgSrc)}"); background-size: cover; background-position: center;`

const lpCity = cityFromHeroOrFallback(hero?.headline, address)

const lpSeasonCopy = (value) => {
  if (!isLp) return asStr(value)
  return asStr(value).replace(/\bSpring\b/gi, 'Summer')
}

const heroHeadlineDisplay = isLp
  ? `Summer Special! Save Money Today On ${lpKeyword}.`
  : asStr(hero?.headline)

const lpFormMainHeading = isLp ? `Get Special Pricing On ${lpKeyword}` : universalFormHeading

const projectsHeadline = isLp ? `Recent ${lpKeyword} Projects` : asStr(projects?.headline)

/** LP-specific project carousel slides (overrides homepage Sanity slides). */
const lpProjectSlidesBySlug = {
  'gutter-guards': [
    {
      imageSrc: 'Media (SGT)/Images (SGT)/sunlife-gutters-tampa-gutter-guards-mesh-corner-trees.png',
      imageAlt: 'Black mesh gutter guards on white gutters at a roof corner',
      location: 'Tampa, FL',
    },
    {
      imageSrc: 'Media (SGT)/Images (SGT)/sunlife-gutters-tampa-gutter-guards-mesh-long-run.png',
      imageAlt: 'Long run of white gutters with black mesh gutter guards',
      location: 'Tampa, FL',
    },
    {
      imageSrc: 'Media (SGT)/Images (SGT)/sunlife-gutters-tampa-gutter-guards-mesh-corner-detail.png',
      imageAlt: 'Close-up of micro-mesh gutter guard installed on a black gutter',
      location: 'Tampa, FL',
    },
  ],
  'gutter-installation': [
    {
      imageSrc: 'Media (SGT)/Images (SGT)/sunlife-gutters-tampa-gutter-installation-fasten-hangers.png',
      imageAlt: 'Installer fastening gutter hangers on a residential roof',
      location: 'Tampa, FL',
    },
    {
      imageSrc: 'Media (SGT)/Images (SGT)/sunlife-gutters-tampa-gutter-installation-finished-corner.png',
      imageAlt: 'Finished light-grey gutter run on a white home with palm trees',
      location: 'Tampa, FL',
    },
    {
      imageSrc: 'Media (SGT)/Images (SGT)/sunlife-gutters-tampa-gutter-installation-downspout-attach.png',
      imageAlt: 'Installer attaching a white downspout with a cordless drill',
      location: 'Tampa, FL',
    },
  ],
  'gutter-repair': [
    {
      imageSrc: 'Media (SGT)/Images (SGT)/sunlife-gutters-tampa-gutter-repair-reseal-from-roof.png',
      imageAlt: 'Technician resealing and securing gutters from the roof',
      location: 'Tampa, FL',
    },
    {
      imageSrc: 'Media (SGT)/Images (SGT)/sunlife-gutters-tampa-gutter-repair-ladder-work.png',
      imageAlt: 'Technician on a ladder repairing white gutters on a two-story home',
      location: 'Tampa, FL',
    },
    {
      imageSrc: 'Media (SGT)/Images (SGT)/sunlife-gutters-tampa-gutter-repair-finished-corner.png',
      imageAlt: 'Finished white gutter corner and downspout on a tile roof home',
      location: 'Tampa, FL',
    },
  ],
}
const projectSlides =
  (isLp && lpProjectSlidesBySlug[lpSlug]) ||
  (Array.isArray(projects?.slides) ? projects.slides : [])

/** LP-specific Google reviews (carousel pages of 4). */
const lpReviewsBySlug = {
  'gutter-guards': gutterGuardsReviews,
  'gutter-installation': gutterInstallationReviews,
  'gutter-repair': gutterRepairReviews,
}
const lpReviewItems = isLp ? lpReviewsBySlug[lpSlug] : null
const useLpReviewsCarousel = Array.isArray(lpReviewItems) && lpReviewItems.length > 0
const reviewCarouselPages = useLpReviewsCarousel ? chunkReviews(lpReviewItems, 4) : []
const homepageTestimonials = Array.isArray(reviews?.testimonials) ? reviews.testimonials : []
const reviewsHeadlineDisplay = useLpReviewsCarousel
  ? `What Tampa Bay homeowners say about our ${lpKeyword}`
  : asStr(reviews?.headline)
const whyChooseHeadline = isLp
  ? `Trusted ${lpKeyword} partner along Florida's west coast`
  : asStr(whyChoose?.headline)
const servicesHeadline = isLp ? 'More Gutter Services' : asStr(services?.headline)
const aboutHeadline = isLp ? `${lpKeyword} for Tampa Bay homes and weather` : asStr(about?.headline)
const uniquePointsHeadline = isLp
  ? `Simple, reliable ${lpKeyword} in Tampa Bay`
  : asStr(uniquePoints?.headline)
const faqHeadline = isLp ? `Tampa ${lpKeyword} questions answered` : asStr(faq?.headline)

const offerBarTextBefore = lpSeasonCopy(offerBar?.textBeforeDiscount)
const offerBarDiscountLabel = lpSeasonCopy(offerBar?.discountLabel)
const offerBarTextAfter = lpSeasonCopy(offerBar?.textAfterDiscount)
const offerBarCtaText = lpSeasonCopy(offerBar?.ctaText)

const showHeroFormKicker = !isLp && asStr(universalFormKicker).trim() !== ''

const heroLeadFormAttr = isLp ? `lp-${lpSlug}-hero` : 'hero'
const footerLeadFormAttr = isLp ? `lp-${lpSlug}-footer` : 'footer'

const heroNameId = isLp ? `lp-${lpSlug}-hero-name` : 'hero-name'
const heroEmailId = isLp ? `lp-${lpSlug}-hero-email` : 'hero-email'
const heroPhoneId = isLp ? `lp-${lpSlug}-hero-phone` : 'hero-phone'
const heroLocationId = isLp ? `lp-${lpSlug}-hero-location` : 'hero-location'
const heroMessageId = isLp ? `lp-${lpSlug}-hero-message` : 'hero-message'
const heroWebsiteId = isLp ? `lp-${lpSlug}-hero-website` : 'hero-website'
const heroSmsConsentId = isLp ? `lp-${lpSlug}-hero-sms-consent` : 'hero-sms-consent'

const footerNameId = isLp ? `lp-${lpSlug}-footer-name` : 'contact-name'
const footerEmailId = isLp ? `lp-${lpSlug}-footer-email` : 'contact-email'
const footerPhoneId = isLp ? `lp-${lpSlug}-footer-phone` : 'contact-phone'
const footerLocationId = isLp ? `lp-${lpSlug}-footer-location` : 'contact-location'
const footerMessageId = isLp ? `lp-${lpSlug}-footer-message` : 'contact-message'
const footerWebsiteId = isLp ? `lp-${lpSlug}-footer-website` : 'contact-website'
const footerSmsConsentId = isLp ? `lp-${lpSlug}-footer-sms-consent` : 'footer-sms-consent'

const layoutDocumentTitle = isLp
  ? `Summer Special: ${lpKeyword} — ${lpCity} | ${companyName}`
  : pageTitle

const normalizeLocationPageHref = (href) => {
  const value = asStr(href).trim()
  if (!value) return ''
  const legacyMap = {
    '/tampa-florida/': '/locations/tampa-florida/',
    '/brandon-florida/': '/locations/brandon-florida/',
    '/gutters-clearwater-fl/': '/locations/gutters-clearwater-fl/',
    '/gutters-saint-petersburg-fl/': '/locations/gutters-saint-petersburg-fl/',
    '/gutters-largo-fl/': '/locations/gutters-largo-fl/',
    '/gutters-plant-city-fl/': '/locations/gutters-plant-city-fl/',
    '/gutters-seffner-fl/': '/locations/gutters-seffner-fl/',
    '/apollo-beach-fl/': '/locations/apollo-beach-fl/',
    '/gutters-riverview-florida/': '/locations/gutters-riverview-florida/',
  }
  return legacyMap[value] || value
}

const normalizeServiceCardHref = (href) => {
  const value = asStr(href).trim()
  if (!value) return ''
  const legacyMap = {
    '/seamless-gutters/': '/seamless-gutters-tampa-fl/',
    '/soffit-and-fascias/': '/soffit-fascia-repair-tampa-fl/',
    '/super-gutters/': '/super-gutters-tampa-fl/',
    '/screen-rooms-and-lanais/': '/screen-rooms-lanais-tampa-fl/',
    '/siding/': '/siding-tampa-fl/',
  }
  return legacyMap[value] || value
}

const serviceHref = (svc) => {
  const explicit = normalizeServiceCardHref(svc?.href)
  if (explicit) return explicit
  const title = asStr(svc?.title).toLowerCase().trim()
  if (!title) return '/seamless-gutters-tampa-fl/'
  const knownSlugs = {
    'seamless gutters': 'seamless-gutters-tampa-fl',
    'soffit & fascia': 'soffit-fascia-repair-tampa-fl',
    'soffit and fascia': 'soffit-fascia-repair-tampa-fl',
    'super gutters': 'super-gutters-tampa-fl',
    'screen rooms & lanais': 'screen-rooms-lanais-tampa-fl',
    'screen rooms and lanais': 'screen-rooms-lanais-tampa-fl',
    siding: 'siding-tampa-fl',
  }
  if (knownSlugs[title]) return `/${knownSlugs[title]}/`
  const slug = title
    .replace(/&/g, ' and ')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '')
  return `/${slug}/`
}
---

<BaseLayout
  title={layoutDocumentTitle}
  description={pageDescription}
  theme={settings.theme}
  forms={{ submitPath: asStr(settings.forms?.submitPath) }}
  homeRevealAnimations
  preloadImageHref={mediaUrl(heroBgSrc)}
  localBusinessName={companyName}
  robotsNoindex={isLp}
>
  <header class="header">
    <div class="offer-bar">
      <div class="offer-bar-inner">
        <p class="offer-message">
          {offerBarTextBefore}
          {offerBarDiscountLabel ? <strong>{offerBarDiscountLabel}</strong> : null}
          {offerBarTextAfter}
          <a
            href={asStr(offerBar?.ctaHref)}
            class="offer-link"
            {...externalLinkAttrs(asStr(offerBar?.ctaHref))}
          >
            <strong>{offerBarCtaText}</strong>
          </a>
        </p>
      </div>
    </div>

    <div class="header-nav">
      <div class="header-inner">
        <a href="/" class="logo" aria-label={logoAriaLabel}>
          <img src={mediaUrl(logoBlack)} alt={companyName} class="logo-img" width="300" height="72" />
        </a>
        <button class="nav-toggle" aria-label="Open menu">
          <span></span><span></span><span></span>
        </button>
        <nav class="nav">
          {navItems?.map((item, i) => {
            const label = asStr(item.label)
            const href = asStr(item.href)
            const dropdown = item.dropdown
            if (Array.isArray(dropdown) && dropdown.length > 0) {
              const ddId = `nav-dd-${i}`
              return (
                <div class="nav-dropdown" data-nav-dropdown>
                  <button
                    type="button"
                    class="nav-dropdown-toggle"
                    aria-expanded="false"
                    aria-haspopup="true"
                    aria-controls={ddId}
                    id={`${ddId}-btn`}
                  >
                    {label}
                    <span class="nav-dropdown-chevron" aria-hidden="true"></span>
                  </button>
                  <ul class="nav-dropdown-menu" id={ddId} role="menu">
                    {dropdown.map((link) => (
                      <li role="none">
                        <a href={asStr(link.href)} role="menuitem" {...externalLinkAttrs(asStr(link.href))}>
                          {asStr(link.label)}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              )
            }
            return (
              <a href={href} {...externalLinkAttrs(href)}>
                {label}
              </a>
            )
          })}
          <a href={telLink} class="btn btn-primary btn-lg">{callLabelNav}</a>
        </nav>
      </div>
    </div>
  </header>
  <div id="header-nav-spacer" class="header-nav-spacer" aria-hidden="true"></div>

  <main>
    <section class="hero hero-split">
      <div class="hero-bg" style={heroBgStyle}></div>
      <div class="container hero-split-inner">
        <div class="hero-copy">
          <div class="hero-eyebrow">{asStr(hero?.eyebrow)}</div>
          <h1>{heroHeadlineDisplay}</h1>
          <p class="hero-typed" aria-live="polite">
            <span id="hero-typed-text"></span><span class="hero-caret" aria-hidden="true">|</span>
          </p>
          <p class="hero-lead">{asStr(hero?.lead)}</p>
          <div class="hero-actions">
            <a href={telLink} class="btn btn-primary btn-lg cta1-primary-call">{callLabelHero}</a>
          </div>
        </div>
        <form
          class="hero-form"
          data-lead-form={heroLeadFormAttr}
          action={universalFormAction}
          method={universalFormMethod}
          aria-label={universalFormAriaLabel}
        >
          <div class="hero-form-heading">
            {showHeroFormKicker ? <div class="hero-form-kicker">{universalFormKicker}</div> : null}
            <h2>{lpFormMainHeading}</h2>
          </div>
          <p class="hero-form-sub">{universalFormIntro}</p>
          <div class="hero-form-grid">
            <div class="hero-form-field">
              <label for={heroNameId}>
                {asStr(universalFormFields?.nameLabel) || 'Name'}{' '}
                <span class="required-mark" aria-hidden="true">{universalRequiredIndicator}</span>
              </label>
              <input id={heroNameId} name="name" type="text" required autocomplete="name" />
            </div>
            <div class="hero-form-field">
              <label for={heroEmailId}>
                {asStr(universalFormFields?.emailLabel) || 'Email'}{' '}
                <span class="required-mark" aria-hidden="true">{universalRequiredIndicator}</span>
              </label>
              <input id={heroEmailId} name="email" type="email" required autocomplete="email" />
            </div>
            <div class="hero-form-field">
              <label for={heroPhoneId}>
                {asStr(universalFormFields?.phoneLabel) || 'Phone'}{' '}
                <span class="required-mark" aria-hidden="true">{universalRequiredIndicator}</span>
              </label>
              <input id={heroPhoneId} name="phone" type="tel" required autocomplete="tel" />
            </div>
            <div class="hero-form-field">
              <label for={heroLocationId}>{asStr(universalFormFields?.cityLabel) || 'City'}</label>
              <input id={heroLocationId} name="location" type="text" autocomplete="address-level2" />
            </div>
            <div class="hero-form-field hero-form-field-full">
              <label for={heroMessageId}>
                {asStr(universalFormFields?.projectDetailsLabel) || 'Project Details'}
              </label>
              <textarea id={heroMessageId} name="message" rows="3"></textarea>
            </div>
          </div>
          <SmsMarketingConsent checkboxId={heroSmsConsentId} />
          <div class="lead-form-honeypot-wrap" aria-hidden="true">
            <label for={heroWebsiteId}>Leave blank</label>
            <input type="text" id={heroWebsiteId} name="website" tabindex="-1" autocomplete="off" />
          </div>
          <p class="lead-form-status" data-lead-form-status role="status" aria-live="polite"></p>
          <button type="submit" class="btn btn-primary btn-lg">{universalSubmitLabel}</button>
        </form>
      </div>
      <section class="brands-marquee" aria-label={asStr(brandsMarquee?.ariaLabel)}>
        <div class="brands-track">
          <div class="brands-inner">
            {[0, 1, 2].map((idx) => (
              <div class="brands-group" aria-hidden={idx > 0 ? 'true' : undefined}>
                {asStrArray(brandsMarquee?.brands).map((b) => (
                  <span class="brand-pill">{b}</span>
                ))}
              </div>
            ))}
          </div>
        </div>
      </section>
    </section>

    <section id="reviews" class="section google-reviews">
      <div class="container">
        <h2 class="section-title reviews-title">{reviewsHeadlineDisplay}</h2>
        <div class="reviews-summary">
          <div class="reviews-summary-left">
            <p class="reviews-summary-brand">
              <img
                src={mediaUrl(asStr(reviewsSummary?.googleIconSrc))}
                alt={asStr(reviewsSummary?.brandLabel)}
                class="google-logo"
                width="20"
                height="20"
                loading="lazy"
                decoding="async"
              />
              <span>{asStr(reviewsSummary?.brandLabel)}</span>
            </p>
            <p class="reviews-summary-rating">
              <strong>{reviewRating}</strong>
              <img
                src={mediaUrl(asStr(reviewsSummary?.starsImageSrc))}
                alt={asStr(reviewsSummary?.starsImageAlt)}
                class="review-stars review-stars-inline"
                width="96"
                height="18"
                loading="lazy"
                decoding="async"
              />
              <span>{reviewCountDisplay}</span>
            </p>
          </div>
          <a
            href={reviewsCtaHref}
            class="btn btn-outline btn-lg request-estimate reviews-summary-cta"
            {...externalLinkAttrs(reviewsCtaHref)}
          >
            {asStr(reviewsSummary?.ctaText)}
          </a>
        </div>

        {useLpReviewsCarousel ? (
          <div class="reviews-carousel" id="reviews-carousel">
            {reviewCarouselPages.map((page, pageIndex) => (
              <div
                class:list={['reviews-carousel-page', 'testimonials-grid', { 'is-active': pageIndex === 0 }]}
                data-page={pageIndex}
                aria-hidden={pageIndex === 0 ? 'false' : 'true'}
              >
                {page.map((t) => (
                  <blockquote class="testimonial">
                    <div class="review-brand review-brand-top">
                      <img
                        src={mediaUrl(asStr(t.avatarSrc))}
                        alt={asStr(t.author)}
                        class="review-avatar"
                        width="48"
                        height="48"
                        loading="lazy"
                        decoding="async"
                      />
                      <div class="review-meta">
                        <strong>{asStr(t.author)}</strong>
                        {asStr(t.timeAgo) ? <span class="review-time">{asStr(t.timeAgo)}</span> : null}
                      </div>
                    </div>
                    <img
                      src={mediaUrl(asStr(reviewsSummary?.starsImageSrc))}
                      alt={asStr(reviewsSummary?.starsImageAlt)}
                      class="review-stars"
                      width="96"
                      height="18"
                      loading="lazy"
                      decoding="async"
                    />
                    <p set:html={`&quot;${t.quoteHtml}&quot;`} />
                    <div class="review-posted-on">
                      <img
                        src={mediaUrl(asStr(reviewsSummary?.googleIconSrc))}
                        alt={asStr(reviewsSummary?.brandLabel)}
                        class="google-logo"
                        width="20"
                        height="20"
                        loading="lazy"
                        decoding="async"
                      />
                      <span>{asStr(reviews?.postedOnLabel)}</span>
                    </div>
                  </blockquote>
                ))}
              </div>
            ))}
            {reviewCarouselPages.length > 1 ? (
              <div class="reviews-carousel-controls" aria-label="Review pages">
                <button type="button" class="project-nav" id="reviews-prev" aria-label="Previous reviews">
                  Prev
                </button>
                <div class="reviews-carousel-dots" role="tablist" aria-label="Review pages">
                  {reviewCarouselPages.map((_, pageIndex) => (
                    <button
                      type="button"
                      class:list={['reviews-carousel-dot', { 'is-active': pageIndex === 0 }]}
                      data-page={pageIndex}
                      role="tab"
                      aria-selected={pageIndex === 0 ? 'true' : 'false'}
                      aria-label={`Reviews page ${pageIndex + 1}`}
                    />
                  ))}
                </div>
                <button type="button" class="project-nav" id="reviews-next" aria-label="Next reviews">
                  Next
                </button>
              </div>
            ) : null}
          </div>
        ) : (
          <div class="testimonials-grid">
            {homepageTestimonials.map((t) => (
              <blockquote class="testimonial">
                <div class="review-brand review-brand-top">
                  <img
                    src={mediaUrl(asStr(t.avatarSrc))}
                    alt={asStr(t.author)}
                    class="review-avatar"
                    width="48"
                    height="48"
                    loading="lazy"
                    decoding="async"
                  />
                  <div class="review-meta">
                    <strong>{asStr(t.author)}</strong>
                    <span class="review-time">{asStr(t.timeAgo)}</span>
                  </div>
                </div>
                <img
                  src={mediaUrl(asStr(reviewsSummary?.starsImageSrc))}
                  alt={asStr(reviewsSummary?.starsImageAlt)}
                  class="review-stars"
                  width="96"
                  height="18"
                  loading="lazy"
                  decoding="async"
                />
                <p>&quot;{asStr(t.quote)}&quot;</p>
                <div class="review-posted-on">
                  <img
                    src={mediaUrl(asStr(reviewsSummary?.googleIconSrc))}
                    alt={asStr(reviewsSummary?.brandLabel)}
                    class="google-logo"
                    width="20"
                    height="20"
                    loading="lazy"
                    decoding="async"
                  />
                  <span>{asStr(reviews?.postedOnLabel)}</span>
                </div>
              </blockquote>
            ))}
          </div>
        )}
      </div>
    </section>

    <section id="process" class="image-scroller" aria-label={asStr(projects?.sectionAriaLabel)}>
      <div class="container projects-head">
        <h2 class="section-title">{projectsHeadline}</h2>
      </div>
      <div class="projects-carousel" id="projects-carousel">
        {projectSlides.map((slide) => {
          const loc = asStr(slide.location)
          const label = `${asStr(slide.imageAlt)} — ${loc}`
          return (
            <article class="project-slide" data-location={loc} aria-label={label}>
              <img
                src={mediaUrl(asStr(slide.imageSrc))}
                alt={asStr(slide.imageAlt)}
                width="1200"
                height="800"
                loading="lazy"
                decoding="async"
              />
              <div class="project-meta">
                <span class="project-pin" aria-hidden="true">📍</span>{' '}
                <span class="project-location-label">{loc}</span>
              </div>
            </article>
          )
        })}
      </div>
      <div class="projects-controls projects-controls-bottom" aria-label={asStr(projects?.controlsAriaLabel)}>
        <button type="button" class="project-nav" id="projects-prev" aria-label={asStr(projects?.prevAriaLabel)}>
          {asStr(projects?.prevLabel)}
        </button>
        <button type="button" class="project-nav" id="projects-next" aria-label={asStr(projects?.nextAriaLabel)}>
          {asStr(projects?.nextLabel)}
        </button>
      </div>
    </section>

    <section id="why-us" class="section why-simple">
      <div class="container why-choose-layout">
        <div class="why-choose-image-wrap">
          <img
            src={mediaUrl(whyChooseImageSrc)}
            alt={asStr(whyChoose?.imageAlt)}
            class="why-choose-image"
            width="1200"
            height="800"
            loading="lazy"
            decoding="async"
          />
          <div class="why-choose-stamp">
            <strong>{homesCountDisplay}</strong>
            <span>{asStr(whyStamp?.line2)}</span>
            <span>{asStr(whyStamp?.line3)}</span>
          </div>
        </div>
        <div class="why-choose-content">
          <div class="why-eyebrow">{asStr(whyChoose?.eyebrow)}</div>
          <h2 class="section-title section-title-secondary">{whyChooseHeadline}</h2>
          <p class="section-lead">{asStr(whyChoose?.lead)}</p>
          <ul class="why-choose-list">
            {whyChoose?.bullets?.map((b) => (
              <li>
                <strong>{asStr(b.title)}</strong> {asStr(b.text)}
              </li>
            ))}
          </ul>
          <p class="why-choose-note">{asStr(whyChoose?.note)}</p>
          <div class="why-choose-actions">
            <a href={telLink} class="btn btn-primary btn-lg">{whyCallLabel}</a>
            <a
              href={asStr(whyCtas?.estimateHref)}
              class="btn btn-outline btn-lg request-estimate"
              {...externalLinkAttrs(asStr(whyCtas?.estimateHref))}
            >
              {asStr(whyCtas?.estimate)}
            </a>
          </div>
        </div>
      </div>
    </section>

    <section id="services" class="section services" style={servicesBgStyle}>
      <div class="container">
        <h2 class="section-title">{servicesHeadline}</h2>
        <div class="services-grid">
          {services?.items?.map((svc) => (
            <article class="service-card">
              <a href={serviceHref(svc)} class="service-image-wrap" style="display:block; color:inherit; text-decoration:none;">
                <span class="service-number">{asStr(svc.number)}</span>
                <h3 class="service-title">{asStr(svc.title)}</h3>
                <p class="service-desc">{asStr(svc.description)}</p>
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section about about-video">
      <div class="container about-grid">
        <div class="about-content">
          <div class="about-eyebrow">{asStr(about?.eyebrow)}</div>
          <h2 class="section-title">{aboutHeadline}</h2>
          <p class="about-lead">{asStr(about?.lead)}</p>
          <ul class="about-list">
            {asStrArray(about?.bullets).map((line) => (
              <li>{line}</li>
            ))}
          </ul>
          <div class="about-video-actions">
            <a href={telLink} class="btn btn-primary btn-lg">{aboutCallLabel}</a>
            <a
              href={asStr(about?.ctas?.estimateHref)}
              class="btn btn-outline btn-lg request-estimate"
              {...externalLinkAttrs(asStr(about?.ctas?.estimateHref))}
            >
              {asStr(about?.ctas?.estimate)}
            </a>
          </div>
        </div>
        <div class="about-visual">
          {useAboutImage ? (
            <div class="media-card media-image">
              <img
                src={mediaUrl(aboutVisualImageSrc)}
                alt={`${lpKeyword || 'Gutter'} project photo`}
                width="1200"
                height="800"
                loading="lazy"
                decoding="async"
              />
            </div>
          ) : (
            <div class="media-card media-video">
              <video controls playsinline preload="metadata" poster={mediaUrl(asStr(aboutVideo?.posterSrc))}>
                <source
                  src={mediaUrl(asStr(aboutVideo?.sourceSrc))}
                  type={asStr(aboutVideo?.sourceType).trim() || 'video/mp4'}
                />
              </video>
            </div>
          )}
          <div class="about-badges" aria-label={asStr(about?.badgesAriaLabel)}>
            {(Array.isArray(about?.badges) ? about.badges : []).map((badge) => {
              const src = mediaUrl(asStr(badge?.imageSrc))
              const alt = asStr(badge?.alt) || 'Trust badge'
              const href = asStr(badge?.href).trim()
              if (!src) return null
              const img = <img class="about-badge-img" src={src} alt={alt} loading="lazy" decoding="async" />
              return href ? (
                <a class="about-badge about-badge--linked" href={href} target="_blank" rel="noopener noreferrer">
                  {img}
                </a>
              ) : (
                <div class="about-badge about-badge--img">{img}</div>
              )
            })}
          </div>
        </div>
      </div>
    </section>

    <section class="section unique-points" style={uniquePointsBgStyle}>
      <div class="container">
        <div class="why-eyebrow">{asStr(uniquePoints?.eyebrow)}</div>
        <h2 class="section-title section-title-secondary">{uniquePointsHeadline}</h2>
        <div class="unique-grid">
          {uniquePoints?.items?.map((pt) => (
            <article class="result-item">
              <span class="result-value">
                <span class="result-icon" aria-hidden="true">
                  <UniquePointIcon iconId={asStr(pt.iconId)} />
                </span>
                {asStr(pt.title)}
              </span>
              <p>{asStr(pt.description)}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="stats-thin" aria-label={asStr(statsBar?.ariaLabel)}>
      <div class="container stats-thin-grid">
        {statsBar?.items?.map((row) => (
          <div>
            <strong>{statLookup(statsValues, row.valueKey)}</strong>
            <span>{asStr(row.label)}</span>
          </div>
        ))}
      </div>
    </section>

    <section class="section contact-banner-split">
      <div class="container contact-banner-grid">
        <div class="contact-banner-copy">
          <h2 class="section-title">{asStr(contactBanner?.headline)}</h2>
          <p class="section-lead">{asStr(contactBanner?.paragraph1)}</p>
          <p class="section-lead">{asStr(contactBanner?.paragraph2)}</p>
          <div class="contact-banner-actions">
            <a href={telLink} class="contact-banner-phone">
              <img
                src={mediaUrl(asStr(contactBanner?.phoneIconSrc))}
                alt=""
                aria-hidden="true"
                width="20"
                height="20"
                loading="lazy"
                decoding="async"
              />
              <span class="contact-banner-phone-number">{phoneDisplay}</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <section id="service-area" class="section service-area">
      <div class="container">
        <div class="why-eyebrow">{asStr(serviceArea?.eyebrow)}</div>
        <h2 class="section-title">{asStr(serviceArea?.headline)}</h2>
        <p class="section-lead service-area-intro">{asStr(serviceArea?.intro)}</p>
        <div class="service-area-grid">
          <div class="map-wrap">
            <iframe
              src={mapEmbedUrl}
              width="600"
              height="400"
              style="border:0;"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title={mapIframeTitle}
            ></iframe>
          </div>
          <div class="cities-list">
            <p class="cities-label">{asStr(serviceArea?.citiesLabel)}</p>
            <nav class="cities-nav" aria-label={asStr(serviceArea?.citiesNavAriaLabel)}>
              {serviceArea?.cities?.map((c) => (
                <a href={normalizeLocationPageHref(c.href)} {...externalLinkAttrs(normalizeLocationPageHref(c.href))}>
                  {asStr(c.name)}
                </a>
              ))}
            </nav>
          </div>
        </div>
      </div>
    </section>

    <section id="team" class="section our-team">
      <div class="container">
        <h2 class="section-title">{asStr(team?.headline)}</h2>
        <div class="team-grid">
          {team?.members?.map((m) => (
            <article class="team-card">
              <img
                src={mediaUrl(asStr(m.imageSrc))}
                alt={asStr(m.imageAlt)}
                width="640"
                height="480"
                loading="lazy"
                decoding="async"
              />
              <h3>{asStr(m.name)}</h3>
              <p>{asStr(m.bio)}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="faq" class="section faq-section" aria-labelledby={asStr(faq?.headingId)}>
      <div class="container">
        <div class="faq-panel">
          <h2 class="section-title section-title-secondary" id={asStr(faq?.headingId)}>
            {faqHeadline}
          </h2>
          <div class="faq-list" data-faq-accordion>
            {faq?.items?.map((item, idx) => {
              const n = idx + 1
              const btnId = `faq-btn-${n}`
              const panelId = `faq-panel-${n}`
              return (
                <div class="faq-item">
                  <button
                    type="button"
                    class="faq-summary"
                    id={btnId}
                    aria-expanded="false"
                    aria-controls={panelId}
                  >
                    <span class="faq-question">{asStr(item.question)}</span>
                    <span class="faq-chevron" aria-hidden="true"></span>
                  </button>
                  <div
                    class="faq-answer-outer"
                    id={panelId}
                    role="region"
                    aria-labelledby={btnId}
                    aria-hidden="true"
                  >
                    <div class="faq-answer" set:html={sanitizeCmsHtml(asStr(item.answerHtml))} />
                  </div>
                </div>
              )
            })}
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <section id="contact" class="section contact footer-estimate" aria-labelledby="footer-estimate-heading">
      <div class="container">
        <div class="contact-wrapper">
          <div class="contact-info">
            <h2 class="section-title" id="footer-estimate-heading">{lpFormMainHeading}</h2>
            <p>{asStr(footerEstimate?.intro)}</p>
            <FooterContactInfo
              variant="estimate"
              phoneTel={tel}
              phoneDisplay={phoneDisplay}
              email={email}
              address={address}
              addressHref={addressHref}
            />
          </div>
          <form
            class="contact-form"
            data-lead-form={footerLeadFormAttr}
            action={universalFormAction}
            method={universalFormMethod}
            aria-label="Tell us about your Tampa Bay project"
          >
            <div class="contact-form-grid">
              <div class="contact-form-field">
                <label for={footerNameId}>
                  {asStr(universalFormFields?.nameLabel) || 'Name'}{' '}
                  <span class="required-mark" aria-hidden="true">{universalRequiredIndicator}</span>
                </label>
                <input type="text" id={footerNameId} name="name" required autocomplete="name" />
              </div>
              <div class="contact-form-field">
                <label for={footerEmailId}>
                  {asStr(universalFormFields?.emailLabel) || 'Email'}{' '}
                  <span class="required-mark" aria-hidden="true">{universalRequiredIndicator}</span>
                </label>
                <input type="email" id={footerEmailId} name="email" required autocomplete="email" />
              </div>
              <div class="contact-form-field">
                <label for={footerPhoneId}>
                  {asStr(universalFormFields?.phoneLabel) || 'Phone'}{' '}
                  <span class="required-mark" aria-hidden="true">{universalRequiredIndicator}</span>
                </label>
                <input id={footerPhoneId} name="phone" type="tel" required autocomplete="tel" />
              </div>
              <div class="contact-form-field">
                <label for={footerLocationId}>{asStr(universalFormFields?.cityLabel) || 'City'}</label>
                <input type="text" id={footerLocationId} name="location" autocomplete="address-level2" />
              </div>
              <div class="contact-form-field contact-form-field-full">
                <label for={footerMessageId}>
                  {asStr(universalFormFields?.projectDetailsLabel) || 'Project details'}
                </label>
                <textarea id={footerMessageId} name="message" rows="4"></textarea>
              </div>
            </div>
            <SmsMarketingConsent checkboxId={footerSmsConsentId} />
            <div class="lead-form-honeypot-wrap" aria-hidden="true">
              <label for={footerWebsiteId}>Leave blank</label>
              <input type="text" id={footerWebsiteId} name="website" tabindex="-1" autocomplete="off" />
            </div>
            <p class="lead-form-status" data-lead-form-status role="status" aria-live="polite"></p>
            <button type="submit" class="btn btn-primary btn-lg">{universalSubmitLabel}</button>
          </form>
        </div>
      </div>
    </section>
    <div class="container">
      <div class="footer-inner">
        <div class="footer-brand-block footer-col">
          <img src={mediaUrl(logoWhite)} alt={companyName} class="footer-logo" width="380" height="78" loading="lazy" decoding="async" />
          <p class="footer-address">{descriptionShort}</p>
          <div class="footer-social" aria-label={asStr(footerBrand?.socialAriaLabel)}>
            {footerBrand?.socialLinks?.map((s) => (
              <a href={asStr(s.href)} aria-label={asStr(s.ariaLabel)} {...externalLinkAttrs(asStr(s.href))}>
                <FooterSocialIcon platform={asStr(s.platform)} />
              </a>
            ))}
          </div>
        </div>
        {footerColumns?.map((col) => (
          <div class="footer-col">
            <p class="footer-heading">{asStr(col.heading)}</p>
            {col.links?.length ? (
              <nav class="footer-links" aria-label={asStr(col.ariaLabel)}>
                {col.links.map((link) => (
                  <a href={asStr(link.href)} {...externalLinkAttrs(asStr(link.href))}>
                    {asStr(link.label)}
                  </a>
                ))}
              </nav>
            ) : null}
            {isContactFooterColumnHeading(col.heading) ? (
              <FooterContactInfo
                variant="footer-column"
                phoneTel={tel}
                phoneDisplay={phoneDisplay}
                email={email}
                address={address}
                addressHref={addressHref}
              />
            ) : null}
            {col.hoursHeading ? (
              <p class="footer-heading footer-hours-heading">{asStr(col.hoursHeading)}</p>
            ) : null}
            {col.hoursText ? <FooterHoursRow hoursText={col.hoursText} /> : null}
            {(col.hoursHeading || col.hoursText) ? <FooterSmsDisclosure /> : null}
          </div>
        ))}
      </div>
    </div>
  </footer>

  <div class="footer-support">
    <div class="container footer-support-inner">
      <p>
        <a href={copyrightHref} set:html={copyrightInnerHtml} {...externalLinkAttrs(copyrightHref)}></a>
      </p>
      <nav aria-label={asStr(footerSupport?.ariaLabel)}>
        {footerSupport?.links?.map((link) => (
          <a href={asStr(link.href)} {...externalLinkAttrs(asStr(link.href))}>
            {asStr(link.label)}
          </a>
        ))}
      </nav>
    </div>
  </div>
  <script
    type="application/json"
    id="homepage-typed-phrases"
    data-fallback-phrase={asStr(hero?.typedFallbackPhrase)}
    set:html={JSON.stringify(typedPhrases)}
  />
  <style is:global>
    main h1,
    main h2,
    main h3,
    .footer-heading {
      text-transform: capitalize;
    }
  </style>
</BaseLayout>
