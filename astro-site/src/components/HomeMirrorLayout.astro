      <div class="projects-controls projects-controls-bottom" aria-label={asStr(projects?.controlsAriaLabel)}>
        <button type="button" class="project-nav" id="projects-prev" aria-label={asStr(projects?.prevAriaLabel)}>
          {asStr(projects?.prevLabel)}
        </button>
        <button type="button" class="project-nav" id="projects-next" aria-label={asStr(projects?.nextAriaLabel)}>
          {asStr(projects?.nextLabel)}
        </button>
      </div>
    </section>

    <section id="why-us" class="section why-simple">
      <div class="container why-choose-layout">
        <div class="why-choose-image-wrap">
          <img
            src={mediaUrl(whyChooseImageSrc)}
            alt={asStr(whyChoose?.imageAlt)}
            class="why-choose-image"
            width="1200"
            height="800"
            loading="lazy"
            decoding="async"
          />
          <div class="why-choose-stamp">
            <strong>{homesCountDisplay}</strong>
            <span>{whyStampLine2}</span>
            <span>{whyStampLine3}</span>
          </div>
        </div>
        <div class="why-choose-content">
          <div class="why-eyebrow">{asStr(whyChoose?.eyebrow)}</div>
          <h2 class="section-title section-title-secondary">{whyChooseHeadline}</h2>
          <p class="section-lead">{whyChooseLead}</p>
          <ul class="why-choose-list">
            {whyChooseBullets.map((b) => (
              <li>
                <strong>{asStr(b.title)}</strong>{' '}
                <span set:html={sanitizeCmsHtml(asStr(b.text))} />
              </li>
            ))}
          </ul>
          <p class="why-choose-note">{whyChooseNote}</p>
          <div class="why-choose-actions">
            <a href={telLink} class="btn btn-primary btn-lg">{whyCallLabel}</a>
            <a
              href={asStr(whyCtas?.estimateHref)}
              class="btn btn-outline btn-lg request-estimate"
              {...externalLinkAttrs(asStr(whyCtas?.estimateHref))}
            >
              Book a Consultation
            </a>
          </div>
        </div>
      </div>
    </section>

    <section id="services" class="section services" style={servicesBgStyle}>
      <div class="container">
        <h2 class="section-title">{servicesHeadline}</h2>
        <div class="services-grid">
          {servicesItems.map((svc) => (
            <article class="service-card">
              <a href={serviceHref(svc)} class="service-image-wrap" style="display:block; color:inherit; text-decoration:none;">
                <span class="service-number">{asStr(svc.number)}</span>
                <h3 class="service-title">{asStr(svc.title)}</h3>
                <p class="service-desc">{asStr(svc.description)}</p>
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section about about-video">
      <div class="container about-grid">
        <div class="about-content">
          <div class="about-eyebrow">{asStr(about?.eyebrow)}</div>
          <h2 class="section-title">{aboutHeadline}</h2>
          <p class="about-lead">{aboutLead}</p>
          <ul class="about-list">
            {asStrArray(about?.bullets).map((line) => (
              <li>{line}</li>
            ))}
          </ul>
          <div class="about-video-actions">
            <a href={telLink} class="btn btn-primary btn-lg">{aboutCallLabel}</a>
            <a
              href={asStr(about?.ctas?.estimateHref)}
              class="btn btn-outline btn-lg request-estimate"
              {...externalLinkAttrs(asStr(about?.ctas?.estimateHref))}
            >
              Book a Consultation
            </a>
          </div>
        </div>
        <div class="about-visual">
          {useAboutImage ? (
            <div class="media-card media-image">
              <img
                src={mediaUrl(aboutVisualImageSrc)}
                alt={`${lpKeyword || 'Gutter'} project photo`}
                width="1200"
                height="800"
                loading="lazy"
                decoding="async"
              />
            </div>
          ) : (
            <div class="media-card media-video">
              <video controls playsinline preload="metadata" poster={mediaUrl(asStr(aboutVideo?.posterSrc))}>
                <source
                  src={mediaUrl(asStr(aboutVideo?.sourceSrc))}
                  type={asStr(aboutVideo?.sourceType).trim() || 'video/mp4'}
                />
              </video>
            </div>
          )}
          <div class="about-badges" aria-label={asStr(about?.badgesAriaLabel)}>
            {(Array.isArray(about?.badges) ? about.badges : []).map((badge) => {
              const src = mediaUrl(asStr(badge?.imageSrc))
              const alt = asStr(badge?.alt) || 'Trust badge'
              const href = asStr(badge?.href).trim()
              if (!src) return null
              const img = <img class="about-badge-img" src={src} alt={alt} loading="lazy" decoding="async" />
              return href ? (
                <a class="about-badge about-badge--linked" href={href} target="_blank" rel="noopener noreferrer">
                  {img}
                </a>
              ) : (
                <div class="about-badge about-badge--img">{img}</div>
              )
            })}
          </div>
        </div>
      </div>
    </section>

    <section class="section unique-points" style={uniquePointsBgStyle}>
      <div class="container">
        <div class="why-eyebrow">{asStr(uniquePoints?.eyebrow)}</div>
        <h2 class="section-title section-title-secondary">{uniquePointsHeadline}</h2>
        <div class="unique-grid">
          {uniquePointsItems.map((pt) => (
            <article class="result-item">
              <span class="result-value">
                <span class="result-icon" aria-hidden="true">
                  <UniquePointIcon iconId={asStr(pt.iconId)} />
                </span>
                {asStr(pt.title)}
              </span>
              <p>{asStr(pt.description)}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="stats-thin" aria-label={asStr(statsBar?.ariaLabel)}>
      <div class="container stats-thin-grid">
        {statsBar?.items?.map((row) => {
          const valueKey = asStr(row.valueKey)
          const label =
            valueKey in homepageStatsLabels
              ? homepageStatsLabels[valueKey]
              : asStr(row.label)
          return (
            <div>
              <strong>{statLookup(statsValues, row.valueKey)}</strong>
              {label ? <span>{label}</span> : null}
            </div>
          )
        })}
      </div>
    </section>

    <section class="section contact-banner-split">
      <div class="container contact-banner-grid">
        <div class="contact-banner-copy">
          <h2 class="section-title">{contactBannerHeadline}</h2>
          <p class="section-lead">{contactBannerParagraph1}</p>
          <p class="section-lead">{contactBannerParagraph2}</p>
          <div class="contact-banner-actions">
            <a href={telLink} class="contact-banner-phone">
              <img
                src={mediaUrl(asStr(contactBanner?.phoneIconSrc))}
                alt=""
                aria-hidden="true"
                width="20"
                height="20"
                loading="lazy"
                decoding="async"
              />
              <span class="contact-banner-phone-number">{phoneDisplay}</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <section id="service-area" class="section service-area">
      <div class="container">
        <div class="why-eyebrow">{asStr(serviceArea?.eyebrow)}</div>
        <h2 class="section-title">{serviceAreaHeadline}</h2>
        <p class="section-lead service-area-intro" set:html={sanitizeCmsHtml(serviceAreaIntro)} />
        <div class:list={['service-area-grid', !isLp ? 'service-area-grid--stacked' : null]}>
          <div class="map-wrap">
            <iframe
              src={mapEmbedUrl}
              width="600"
              height="400"
              style="border:0;"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title={mapIframeTitle}
            ></iframe>
          </div>
          <div class:list={['cities-list', !isLp ? 'cities-list--pills' : null]}>
            {isLp ? <p class="cities-label">{asStr(serviceArea?.citiesLabel)}</p> : null}
            {!isLp ? <p class="cities-label">Popular service areas</p> : null}
            <nav
              class:list={['cities-nav', !isLp ? 'cities-nav--pills' : null]}
              aria-label={asStr(serviceArea?.citiesNavAriaLabel) || 'Cities we serve'}
            >
              {serviceAreaCities.map((c) => {
                const href = normalizeLocationPageHref(asStr(c.href))
                return (
                  <a href={href} {...externalLinkAttrs(href)}>
                    {asStr(c.name)}
                  </a>
                )
              })}
            </nav>
          </div>
        </div>
      </div>
    </section>

    <section id="team" class="section our-team">
      <div class="container">
        <h2 class="section-title">{teamHeadline}</h2>
        <div class="team-grid">
          {team?.members?.map((m) => (
            <article class="team-card">
              <img
                src={mediaUrl(asStr(m.imageSrc))}
                alt={asStr(m.imageAlt)}
                width="640"
                height="480"
                loading="lazy"
                decoding="async"
              />
              <h3>{asStr(m.name)}</h3>
              <p>{asStr(m.bio)}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="faq" class="section faq-section" aria-labelledby={asStr(faq?.headingId)}>
      <div class="container">
        <div class="faq-panel">
          <h2 class="section-title section-title-secondary" id={asStr(faq?.headingId)}>
            {faqHeadline}
          </h2>
          <div class="faq-list" data-faq-accordion>
            {faqItems.map((item, idx) => {
              const n = idx + 1
              const btnId = `faq-btn-${n}`
              const panelId = `faq-panel-${n}`
              return (
                <div class="faq-item">
                  <button
                    type="button"
                    class="faq-summary"
                    id={btnId}
                    aria-expanded="false"
                    aria-controls={panelId}
                  >
                    <span class="faq-question">{asStr(item.question)}</span>
                    <span class="faq-chevron" aria-hidden="true"></span>
                  </button>
                  <div
                    class="faq-answer-outer"
                    id={panelId}
                    role="region"
                    aria-labelledby={btnId}
                    aria-hidden="true"
                  >
                    <div class="faq-answer" set:html={sanitizeCmsHtml(asStr(item.answerHtml))} />
                  </div>
                </div>
              )
            })}
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <section id="contact" class="section contact footer-estimate" aria-labelledby="footer-estimate-heading">
      <div class="container">
        <div class="contact-wrapper">
          <div class="contact-info">
            <h2 class="section-title" id="footer-estimate-heading">{lpFormMainHeading}</h2>
            <p>{universalFormIntro}</p>
            <FooterContactInfo
              variant="estimate"
              phoneTel={tel}
              phoneDisplay={phoneDisplay}
              email={email}
              address={address}
              addressHref={addressHref}
            />
          </div>
          <form
            class="contact-form"
            data-lead-form={footerLeadFormAttr}
            action={universalFormAction}
            method={universalFormMethod}
            aria-label={lpFormAriaLabel}
          >
            <div class="contact-form-grid">
              <div class="contact-form-field">
                <label for={footerNameId}>
                  {asStr(universalFormFields?.nameLabel) || 'Name'}{' '}
                  <span class="required-mark" aria-hidden="true">{universalRequiredIndicator}</span>
                </label>
                <input type="text" id={footerNameId} name="name" required autocomplete="name" />
              </div>
              <div class="contact-form-field">
                <label for={footerEmailId}>
                  {asStr(universalFormFields?.emailLabel) || 'Email'}{' '}
                  <span class="required-mark" aria-hidden="true">{universalRequiredIndicator}</span>
                </label>
                <input type="email" id={footerEmailId} name="email" required autocomplete="email" />
              </div>
              <div class="contact-form-field">
                <label for={footerPhoneId}>
                  {asStr(universalFormFields?.phoneLabel) || 'Phone'}{' '}
                  <span class="required-mark" aria-hidden="true">{universalRequiredIndicator}</span>
                </label>
                <input id={footerPhoneId} name="phone" type="tel" required autocomplete="tel" />
              </div>
              <div class="contact-form-field">
                <label for={footerLocationId}>{asStr(universalFormFields?.cityLabel) || 'City'}</label>
                <input type="text" id={footerLocationId} name="location" autocomplete="address-level2" />
              </div>
              <div class="contact-form-field contact-form-field-full">
                <label for={footerMessageId}>
                  {asStr(universalFormFields?.projectDetailsLabel) || 'Project details'}
                </label>
                <textarea id={footerMessageId} name="message" rows="4"></textarea>
              </div>
            </div>
            <SmsMarketingConsent checkboxId={footerSmsConsentId} />
            <div class="lead-form-honeypot-wrap" aria-hidden="true">
              <label for={footerWebsiteId}>Leave blank</label>
              <input type="text" id={footerWebsiteId} name="website" tabindex="-1" autocomplete="off" />
            </div>
            <p class="lead-form-status" data-lead-form-status role="status" aria-live="polite"></p>
            <button type="submit" class="btn btn-primary btn-lg">{universalSubmitLabel}</button>
          </form>
        </div>
      </div>
    </section>
    <div class="container">
      <div class="footer-inner">
        <div class="footer-brand-block footer-col">
          <img src={mediaUrl(logoWhite)} alt={companyName} class="footer-logo" width="380" height="78" loading="lazy" decoding="async" />
          <p class="footer-address">{descriptionShort}</p>
          <div class="footer-social" aria-label={asStr(footerBrand?.socialAriaLabel)}>
            {footerBrand?.socialLinks?.map((s) => (
              <a href={asStr(s.href)} aria-label={asStr(s.ariaLabel)} {...externalLinkAttrs(asStr(s.href))}>
                <FooterSocialIcon platform={asStr(s.platform)} />
              </a>
            ))}
          </div>
        </div>
        {footerColumns?.map((col) => (
          <div class="footer-col">
            <p class="footer-heading">{asStr(col.heading)}</p>
            {col.links?.length ? (
              <nav class="footer-links" aria-label={asStr(col.ariaLabel)}>
                {col.links.map((link) => (
                  <a href={asStr(link.href)} {...externalLinkAttrs(asStr(link.href))}>
                    {asStr(link.label)}
                  </a>
                ))}
              </nav>
            ) : null}
            {isContactFooterColumnHeading(col.heading) ? (
              <FooterContactInfo
                variant="footer-column"
                phoneTel={tel}
                phoneDisplay={phoneDisplay}
                email={email}
                address={address}
                addressHref={addressHref}
              />
            ) : null}
            {col.hoursHeading ? (
              <p class="footer-heading footer-hours-heading">{asStr(col.hoursHeading)}</p>
            ) : null}
            {col.hoursText ? <FooterHoursRow hoursText={col.hoursText} /> : null}
            {(col.hoursHeading || col.hoursText) ? <FooterSmsDisclosure /> : null}
          </div>
        ))}
      </div>
    </div>
  </footer>

  <FooterFinancingDisclosure />

  <div class="footer-support">
    <div class="container footer-support-inner">
      <p>
        <a href={copyrightHref} set:html={copyrightInnerHtml} {...externalLinkAttrs(copyrightHref)}></a>
      </p>
      <nav aria-label={asStr(footerSupport?.ariaLabel)}>
        {footerSupport?.links?.map((link) => (
          <a href={asStr(link.href)} {...externalLinkAttrs(asStr(link.href))}>
            {asStr(link.label)}
          </a>
        ))}
      </nav>
    </div>
  </div>
  <script
    type="application/json"
    id="homepage-typed-phrases"
    data-fallback-phrase={asStr(hero?.typedFallbackPhrase)}
    set:html={JSON.stringify(typedPhrases)}
  />
  <style is:global>
    main h1,
    main h2,
    main h3,
    .footer-heading {
      text-transform: capitalize;
    }
  </style>
</BaseLayout>
