---
/**
 * Sitewide footer: warranty * plus GreenSky Important Financing Terms.
 */
import {
  GREENSKY_FINANCING,
  GREENSKY_MAIN_DISCLOSURE,
  getAdvertisedPlans,
  linkifyMainDisclosure,
} from '../lib/greensky-financing.js'

const cfg = GREENSKY_FINANCING
const plans = getAdvertisedPlans()
const mainDisclosureHtml = linkifyMainDisclosure(GREENSKY_MAIN_DISCLOSURE)
---

<div class="footer-financing">
  <div class="container">
    <p class="footer-financing-text">
      *The cost of lifetime warranty options varies based on the project, home size, and other
      important factors. SunLife Gutters Tampa offers lifetime warranty options and other
      warranties. Talk to your sales representative or contact us for more information.
    </p>
    <div class="footer-financing-terms" id="financing-terms">
      <h2 class="footer-financing-heading">{cfg.termsHeading}</h2>
      {
        plans.map((plan) => (
          <p class="footer-financing-text">
            <sup>{plan.footnote}</sup> {plan.disclosure}
          </p>
        ))
      }
      <p class="footer-financing-text" set:html={mainDisclosureHtml} />
    </div>
  </div>
</div>
