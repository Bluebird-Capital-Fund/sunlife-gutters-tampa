---
/**
 * Spanish homepage main sections (chrome provided by EsSiteChrome).
 * Content mirrors the English homepage (HomeMirrorLayout homepage branch).
 */
import UniquePointIcon from './UniquePointIcon.astro'
import FinancingBanner from './FinancingBanner.astro'
import SmsMarketingConsent from './SmsMarketingConsent.astro'
import { getSiteSettings, getHomePage } from '../lib/site-settings.js'
import {
  asStr,
  asStrArray,
  mediaUrl,
  statLookup,
} from '../lib/sanity-strings.js'
import { sanitizeCmsHtml } from '../lib/sanitize-cms-html.js'
import {
  POPULAR_SERVICE_AREA_CITIES,
} from '../lib/service-area-cities.js'
import { EN_TO_ES_PATH, ES_FORM_INTRO, ES_NAV, LIVE_ES_PATHS, LOCALE_ES, localizeMapEmbedUrl } from '../lib/i18n.js'

const [settings, homePage] = await Promise.all([getSiteSettings(), getHomePage()])

const business = settings?.business ?? {}
const phoneDisplay = asStr(business?.phoneDisplay) || '(813) 548-5310'
const tel = asStr(business?.phoneTel) || '8135485310'
const telLink = `tel:${tel}`
const companyName = 'SunLife Gutters Tampa'
const statsValues = settings?.statsValues
const mapEmbedUrl = localizeMapEmbedUrl(asStr(settings?.mapEmbedUrl), LOCALE_ES)

const hp = homePage ?? {}
const brandsMarquee = hp.brandsMarquee
const projects = hp.projects
const projectSlides = Array.isArray(projects?.slides) ? projects.slides : []
const whyChoose = hp.whyChoose
const whyStamp = whyChoose?.stamp
const about = hp.about
const aboutVideo = about?.video
const statsBar = hp.statsBar
const reviews = settings?.reviews ?? hp.reviews
const reviewsSummary = reviews?.summary
const reviewValues = reviews?.reviewValues
const formsCfg = settings?.forms ?? {}
const footerEstimate = settings?.footerEstimate ?? hp.footerEstimate
const contactBanner = hp.contactBanner

const reviewRating = statLookup(reviewValues, reviewsSummary?.ratingValueKey)
const reviewCount = statLookup(reviewValues, reviewsSummary?.reviewCountKey)
const reviewCountDisplay = `${asStr(reviewsSummary?.reviewCountPrefix)}${reviewCount}${asStr(reviewsSummary?.reviewCountSuffix)}`

const layoutBg = hp.layoutBackgrounds
const heroBgSrc = asStr(layoutBg?.hero?.imageSrc)
const servicesBgSrc = asStr(layoutBg?.services?.imageSrc)
const uniquePointsBgSrc = asStr(layoutBg?.uniquePoints?.imageSrc)
const whyChooseImageSrc = asStr(whyChoose?.imageSrc)
const heroPhotoUrl = heroBgSrc ? mediaUrl(heroBgSrc) : ''
const heroBgStyle = heroPhotoUrl
  ? `--hero-photo: url('${heroPhotoUrl}'); background-image: linear-gradient(135deg, rgba(56, 69, 85, 0.88) 0%, rgba(56, 69, 85, 0.84) 50%, rgba(56, 69, 85, 0.88) 100%), var(--hero-photo); background-size: cover; background-position: center; background-repeat: no-repeat;`
  : undefined
const servicesBgStyle = servicesBgSrc
  ? `background-image: linear-gradient(rgba(12, 28, 46, 0.82), rgba(12, 28, 46, 0.82)), url('${mediaUrl(servicesBgSrc)}')`
  : undefined
const uniquePointsBgStyle = uniquePointsBgSrc
  ? `background-image: linear-gradient(rgba(255,255,255,0.92), rgba(255,255,255,0.92)), url('${mediaUrl(uniquePointsBgSrc)}')`
  : undefined

const formAction = asStr(formsCfg?.submitPath) || asStr(footerEstimate?.formAction) || '/api/lead'
const formMethod = asStr(footerEstimate?.formMethod) || 'post'

const typedPhrases = [
  'Instalación de canaletas',
  'Canaletas seamless',
  'Reparación de canaletas',
  'Super Gutters',
  'Protectores de canaletas',
]

const homepageTestimonials = Array.isArray(reviews?.testimonials)
  ? reviews.testimonials.slice(0, 6)
  : []

const homesCountRaw =
  asStr(whyStamp?.homesCountTemplate)?.replace(
    /\{\{\s*count\s*\}\}/gi,
    statLookup(statsValues, whyStamp?.homesCountKey) || '10,000+',
  ) || 'Over 10,000+'
const homesCountDisplay = homesCountRaw.replace(/^Over\s+/i, 'Más de ')

function serviceHref(enPath) {
  const es = EN_TO_ES_PATH[enPath]
  if (es && LIVE_ES_PATHS.has(es)) return es
  return enPath
}

const servicesItems = [
  {
    number: '01',
    title: 'Canaletas comerciales',
    description:
      'Proteja su propiedad comercial con sistemas de canaletas a medida, hechos para la lluvia intensa de Florida y para dirigir el agua donde corresponde.',
    href: serviceHref('/commercial-gutters-tampa-fl/'),
  },
  {
    number: '02',
    title: 'Canaletas seamless',
    description:
      'Mejore su hogar con canaletas seamless a medida que ofrecen protección duradera, menos fugas y un acabado limpio.',
    href: serviceHref('/seamless-gutters-tampa-fl/'),
  },
  {
    number: '03',
    title: 'Super Gutters',
    description:
      'Diseñados para enclosures de piscina y techos grandes, los Super Gutters aportan la fuerza y capacidad que exigen las tormentas de Florida.',
    href: serviceHref('/super-gutters-tampa-fl/'),
  },
  {
    number: '04',
    title: 'Screen Rooms & Lanais',
    description:
      'Disfrute más del estilo de vida de Florida con screen rooms y lanais a medida, pensados para comodidad y vida al aire libre todo el año.',
    href: serviceHref('/screen-rooms-lanais-tampa-fl/'),
  },
  {
    number: '05',
    title: 'Reparación de soffit y fascia',
    description:
      'Proteja la línea del techo y renueve el exterior con reparación experta de soffit y fascia que restaura función y atractivo.',
    href: serviceHref('/soffit-fascia-repair-tampa-fl/'),
  },
  {
    number: '06',
    title: 'Siding',
    description:
      'Dé a su hogar un look renovado con siding duradero que mejora el atractivo y resiste el calor, la humedad y el clima de Florida.',
    href: serviceHref('/siding-tampa-fl/'),
  },
]

const uniquePointsItems = [
  {
    iconId: 'clipboard',
    title: 'Estimados honestos',
    description:
      'Ofrecemos estimados claros y directos, con precios transparentes y recomendaciones en las que puede confiar. Sin sorpresas ni ventas innecesarias.',
  },
  {
    iconId: 'package',
    title: 'Hechas para el clima de Florida',
    description:
      'Cada sistema de canaletas está diseñado para la lluvia intensa, las tormentas de verano y la humedad de Tampa Bay, ayudando a proteger su hogar del daño por agua.',
  },
  {
    iconId: 'shield-check',
    title: 'Empresa familiar, experiencia local',
    description:
      'Como empresa familiar que sirve a Tampa Bay desde 2018, conocemos las casas, los vecindarios y el clima que definen cada instalación.',
  },
  {
    iconId: 'sparkle',
    title: 'Mano de obra de calidad',
    description:
      'Desde canaletas seamless a medida hasta mejoras exteriores, cada proyecto se completa con atención al detalle y para durar.',
  },
  {
    iconId: 'clock',
    title: 'Respeto por su hogar',
    description:
      'Tratamos su propiedad como la nuestra: protegemos el paisaje, mantenemos el sitio limpio y hacemos un recorrido final antes de irnos.',
  },
  {
    iconId: 'message',
    title: 'Comunicación clara',
    description:
      'Desde el primer estimado hasta el recorrido final, siempre sabrá qué esperar con un servicio receptivo y comunicación constante en cada paso.',
  },
]

const faqItems = [
  {
    question: '¿Qué tamaño de canaletas es mejor para casas en Tampa?',
    answerHtml:
      'Para muchas casas en Tampa, las canaletas de 6 pulgadas son una buena opción porque su mayor capacidad ayuda a manejar la lluvia intensa común en la zona. Las de 5 pulgadas pueden funcionar bien en techos más pequeños o sencillos. El mejor tamaño depende del área del techo, la pendiente, los valles, la capacidad de bajantes y el diseño del drenaje. Consideramos estos factores para que el sistema maneje bien el escurrimiento.',
  },
  {
    question: '¿Son mejores las canaletas seamless para casas en Tampa?',
    answerHtml:
      'Las canaletas seamless son una buena opción para casas en Tampa porque tienen menos uniones a lo largo de cada tramo, lo que reduce puntos donde pueden surgir fugas. Se fabrican a la medida de la línea del techo y pueden ofrecer drenaje consistente durante las lluvias fuertes frecuentes de Tampa. Aún se necesitan uniones en esquinas y ciertas conexiones, pero menos juntas suelen significar menos puntos débiles en el sistema.',
  },
  {
    question: '¿Pueden instalar canaletas en una casa en Tampa que nunca las ha tenido?',
    answerHtml:
      'Sí. Se pueden agregar canaletas a la mayoría de las casas en Tampa aunque se hayan construido sin ellas. Revisamos la línea del techo, el estado de la fascia, los patrones de escurrimiento y ubicaciones adecuadas de bajantes para diseñar un sistema efectivo. Esto es especialmente importante en Tampa, donde la lluvia intensa puede enviar mucha agua del techo hacia cimientos, jardines, patios, pasillos y otras áreas de la propiedad.',
  },
  {
    question: '¿Cómo sé si mis canaletas necesitan reparación o reemplazo en Tampa?',
    answerHtml:
      'Las canaletas en Tampa a menudo se pueden reparar cuando el problema es una fuga pequeña, un sujetador suelto, una unión separada o daño aislado. El reemplazo puede ser mejor ante corrosión generalizada, hundimiento, fugas recurrentes o canaletas que se desprenden de la fascia. Durante una inspección evaluamos todo el sistema, incluido el drenaje y los bajantes, para determinar si conviene reparar o reemplazar en su casa en Tampa.',
  },
  {
    question: '¿Valen la pena los protectores de canaletas para casas en Tampa?',
    answerHtml:
      'Los protectores de canaletas pueden valer la pena en casas de Tampa, especialmente con árboles cercanos que sueltan hojas, agujas de pino, semillas y otros escombros. Ayudan a reducir la acumulación para que el agua fluya mejor durante lluvias fuertes. No eliminan por completo el mantenimiento. Seguimos recomendando inspecciones y limpieza periódicas para que canaletas y bajantes funcionen bien en el clima lluvioso de Tampa.',
  },
]

const statsLabelMap = {
  statsYearsExperience: 'opciones de garantía*',
  statsJobsCompleted: 'Proyectos completados',
  statsAvgRating: 'Calificación promedio en Google',
}

const esServiceIntro =
  'Estamos orgullosos de ofrecer servicios de canaletas y exteriores en todo Tampa Bay, incluyendo Clearwater, Tampa, St. Petersburg, Wesley Chapel, Plant City y comunidades cercanas. Con base en Seffner, nuestro equipo local ayuda cada día a propietarios y negocios a proteger sus propiedades con trabajo de calidad y servicio honesto. ¿No ve su ciudad? Contáctenos; es posible que aún podamos ayudar.'

function translateStatValue(value) {
  const v = asStr(value)
  if (/^lifetime$/i.test(v)) return 'De por vida'
  if (/^over\s+/i.test(v)) return v.replace(/^over\s+/i, 'Más de ')
  return v
}
---

<main>
  <section class="hero hero-split">
    <div class="hero-bg" style={heroBgStyle}></div>
    <div class="container hero-split-inner">
      <div class="hero-copy">
        <div class="hero-eyebrow">Empresa familiar de canaletas en Tampa Bay</div>
        <h1>La Mejor Empresa de Canaletas en Tampa</h1>
        <p class="hero-typed" aria-live="polite">
          <span id="hero-typed-text"></span><span class="hero-caret" aria-hidden="true">|</span>
        </p>
        <ul class="hero-lead hero-lead-list">
          <li><strong>Más de 10,000</strong> proyectos completados</li>
          <li><strong>Más de 7 años</strong> sirviendo Tampa Bay</li>
          <li>
            <strong>Calificación 4.9 en Google</strong> de <strong>247 reseñas</strong>
          </li>
          <li><strong>Empresa familiar</strong> con sede en Seffner</li>
          <li><strong>Opciones de garantía de por vida</strong> disponibles*</li>
          <li><strong>Financiamiento flexible</strong> disponible</li>
          <li><strong>Comunicación clara</strong> desde el estimado hasta la instalación</li>
        </ul>
        <div class="hero-actions">
          <a href={telLink} class="btn btn-primary btn-lg cta1-primary-call">
            {ES_NAV.callPrefix} {phoneDisplay}
          </a>
        </div>
      </div>
      <form
        class="hero-form"
        data-lead-form="es-home-hero"
        data-page-locale="es-US"
        action={formAction}
        method={formMethod}
        aria-label="Formulario de consulta"
      >
        <input type="hidden" name="pageLocale" value="es-US" />
        <input type="hidden" name="language" value="es-US" />
        <div class="hero-form-heading">
          <div class="hero-form-kicker">{ES_NAV.freeEstimate}</div>
          <h2>{ES_NAV.bookConsultation}</h2>
        </div>
        <p class="hero-form-sub">{ES_FORM_INTRO}</p>
        <div class="hero-form-grid">
          <div class="hero-form-field">
            <label for="es-hero-name">
              {ES_NAV.name} <span class="required-mark" aria-hidden="true">{ES_NAV.required}</span>
            </label>
            <input id="es-hero-name" name="name" type="text" required autocomplete="name" />
          </div>
          <div class="hero-form-field">
            <label for="es-hero-email">
              {ES_NAV.email} <span class="required-mark" aria-hidden="true">{ES_NAV.required}</span>
            </label>
            <input id="es-hero-email" name="email" type="email" required autocomplete="email" />
          </div>
          <div class="hero-form-field">
            <label for="es-hero-phone">
              {ES_NAV.phone} <span class="required-mark" aria-hidden="true">{ES_NAV.required}</span>
            </label>
            <input id="es-hero-phone" name="phone" type="tel" required autocomplete="tel" />
          </div>
          <div class="hero-form-field">
            <label for="es-hero-location">{ES_NAV.city}</label>
            <input id="es-hero-location" name="location" type="text" autocomplete="address-level2" />
          </div>
          <div class="hero-form-field hero-form-field-full">
            <label for="es-hero-message">{ES_NAV.projectDetails}</label>
            <textarea id="es-hero-message" name="message" rows="3"></textarea>
          </div>
        </div>
        <SmsMarketingConsent checkboxId="es-hero-sms-consent" locale="es" />
        <div class="lead-form-honeypot-wrap" aria-hidden="true">
          <label for="es-hero-website">Leave blank</label>
          <input type="text" id="es-hero-website" name="website" tabindex="-1" autocomplete="off" />
        </div>
        <p class="lead-form-status" data-lead-form-status role="status" aria-live="polite"></p>
        <button type="submit" class="btn btn-primary btn-lg">{ES_NAV.submit}</button>
      </form>
    </div>
    <section class="brands-marquee" aria-label={asStr(brandsMarquee?.ariaLabel) || 'Marcas'}>
      <div class="brands-track">
        <div class="brands-inner">
          {[0, 1, 2].map((idx) => (
            <div class="brands-group" aria-hidden={idx > 0 ? 'true' : undefined}>
              {asStrArray(brandsMarquee?.brands).map((b) => (
                <span class="brand-pill">{b}</span>
              ))}
            </div>
          ))}
        </div>
      </div>
    </section>
  </section>

  <FinancingBanner phoneDisplay={phoneDisplay} phoneTel={tel} locale="es" />

  <section id="reviews" class="section google-reviews">
    <div class="container">
      <h2 class="section-title reviews-title">Lo que dicen los vecinos de Tampa Bay</h2>
      <div class="reviews-summary">
        <div class="reviews-summary-left">
          <p class="reviews-summary-brand">
            <img
              src={mediaUrl(asStr(reviewsSummary?.googleIconSrc))}
              alt={asStr(reviewsSummary?.brandLabel) || 'Google'}
              class="google-logo"
              width="20"
              height="20"
              loading="lazy"
              decoding="async"
            />
            <span>{asStr(reviewsSummary?.brandLabel) || 'Google'}</span>
          </p>
          <p class="reviews-summary-rating">
            <strong>{reviewRating}</strong>
            <img
              src={mediaUrl(asStr(reviewsSummary?.starsImageSrc))}
              alt={asStr(reviewsSummary?.starsImageAlt)}
              class="review-stars review-stars-inline"
              width="96"
              height="18"
              loading="lazy"
              decoding="async"
            />
            <span>{reviewCountDisplay}</span>
          </p>
        </div>
        <a href="/es/testimonios/" class="btn btn-outline btn-lg request-estimate reviews-summary-cta">
          Solicitar consulta
        </a>
      </div>
      <div class="testimonials-grid">
        {homepageTestimonials.map((t) => (
          <blockquote class="testimonial">
            <div class="review-brand review-brand-top">
              <img
                src={mediaUrl(asStr(t.avatarSrc))}
                alt={asStr(t.author)}
                class="review-avatar"
                width="48"
                height="48"
                loading="lazy"
                decoding="async"
              />
              <div class="review-meta">
                <strong>{asStr(t.author)}</strong>
                <span class="review-time">{asStr(t.timeAgo)}</span>
              </div>
            </div>
            <img
              src={mediaUrl(asStr(reviewsSummary?.starsImageSrc))}
              alt={asStr(reviewsSummary?.starsImageAlt)}
              class="review-stars"
              width="96"
              height="18"
              loading="lazy"
              decoding="async"
            />
            <p>&quot;{asStr(t.quote)}&quot;</p>
            <div class="review-posted-on">
              <img
                src={mediaUrl(asStr(reviewsSummary?.googleIconSrc))}
                alt={asStr(reviewsSummary?.brandLabel)}
                class="google-logo"
                width="20"
                height="20"
                loading="lazy"
                decoding="async"
              />
              <span>{asStr(reviews?.postedOnLabel) || 'Publicado en Google'}</span>
            </div>
          </blockquote>
        ))}
      </div>
    </div>
  </section>

  {projectSlides.length > 0 ? (
    <section id="process" class="image-scroller" aria-label="Proyectos recientes">
      <div class="container projects-head">
        <h2 class="section-title projects-title">
          Trabajo reciente de canaletas en Tampa y alrededores
        </h2>
      </div>
      <div class="projects-carousel" id="projects-carousel">
        {projectSlides.map((slide, slideIndex) => {
          const loc = asStr(slide.location)
          const label = `${asStr(slide.imageAlt)} — ${loc}`
          const slideCount = projectSlides.length
          const slideClass =
            slideIndex === 0
              ? 'project-slide project-active'
              : slideIndex === 1
                ? 'project-slide project-next'
                : slideIndex === slideCount - 1
                  ? 'project-slide project-prev'
                  : 'project-slide'
          return (
            <article class={slideClass} data-location={loc} aria-label={label}>
              <img
                src={mediaUrl(asStr(slide.imageSrc))}
                alt={asStr(slide.imageAlt)}
                width="1200"
                height="800"
                loading={slideIndex === 0 ? 'eager' : 'lazy'}
                decoding="async"
              />
              <div class="project-meta">
                <span class="project-pin" aria-hidden="true">📍</span>{' '}
                <span class="project-location-label">{loc}</span>
              </div>
            </article>
          )
        })}
      </div>
      <div class="projects-controls projects-controls-bottom" aria-label="Controles del carrusel">
        <button type="button" class="project-nav" id="projects-prev" aria-label="Anterior">
          ←
        </button>
        <button type="button" class="project-nav" id="projects-next" aria-label="Siguiente">
          →
        </button>
      </div>
    </section>
  ) : null}

  <section id="why-us" class="section why-simple">
    <div class="container why-choose-layout">
      <div class="why-choose-image-wrap">
        {whyChooseImageSrc ? (
          <img
            src={mediaUrl(whyChooseImageSrc)}
            alt={asStr(whyChoose?.imageAlt) || 'Equipo de SunLife Gutters en Tampa'}
            class="why-choose-image"
            width="1200"
            height="800"
            loading="lazy"
            decoding="async"
          />
        ) : null}
        <div class="why-choose-stamp">
          <strong>{homesCountDisplay}</strong>
          <span>Tampa Bay, Florida</span>
          <span>Proyectos completados de techo a terreno.</span>
        </div>
      </div>
      <div class="why-choose-content">
        <div class="why-eyebrow">Por qué SunLife</div>
        <h2 class="section-title section-title-secondary">
          La opción local de confianza para canaletas en Tampa Bay
        </h2>
        <p class="section-lead">
          Desde casas frente al agua y vecindarios consolidados hasta comunidades en crecimiento en
          todo Tampa Bay, ofrecemos soluciones de canaletas y exteriores a medida, respaldadas por
          recomendaciones honestas, buena mano de obra y comunicación clara desde el estimado hasta
          el recorrido final.
        </p>
        <ul class="why-choose-list">
          <li>
            <strong>Hechas para el clima de Florida:</strong>{' '}
            Cada sistema está diseñado para manejar lluvia intensa, tormentas fuertes y humedad todo
            el año, ayudando a proteger cimientos, línea del techo y jardines.
          </li>
          <li>
            <strong>Soluciones exteriores completas:</strong>{' '}
            Desde canaletas seamless y Super Gutters hasta protectores, screen rooms, lanais, trim
            de techo,{' '}
            <a href={serviceHref('/gutter-repair-tampa-fl/')}>reparaciones de canaletas en Tampa</a>
            {' '}y mantenimiento, un solo equipo local con experiencia lo maneja todo.
          </li>
          <li>
            <strong>De la confianza de propietarios de Tampa Bay:</strong>{' '}
            Desde 2018 hemos servido a más de 10,000 clientes con trabajo confiable, precios justos
            y una experiencia sin estrés respaldada por un servicio receptivo.
          </li>
        </ul>
        <p class="why-choose-note">
          Pregunte por mejoras listas para tormentas, incluyendo protectores de canaletas,
          extensiones de bajantes y mantenimiento preventivo para ayudar a proteger su hogar todo el
          año.
        </p>
        <div class="why-choose-actions">
          <a href={telLink} class="btn btn-primary btn-lg">
            {ES_NAV.callPrefix} {phoneDisplay}
          </a>
          <a href="/es/contacto/#contact" class="btn btn-outline btn-lg request-estimate">
            {ES_NAV.bookConsultation}
          </a>
        </div>
      </div>
    </div>
  </section>

  <section id="services" class="section services" style={servicesBgStyle}>
    <div class="container">
      <h2 class="section-title">Servicios de canaletas en Tampa hechos para el clima de Florida</h2>
      <div class="services-grid">
        {servicesItems.map((svc) => (
          <article class="service-card">
            <a
              href={svc.href}
              class="service-image-wrap"
              style="display:block; color:inherit; text-decoration:none;"
            >
              <span class="service-number">{svc.number}</span>
              <h3 class="service-title">{svc.title}</h3>
              <p class="service-desc">{svc.description}</p>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section about about-video">
    <div class="container about-grid">
      <div class="about-content">
        <div class="about-eyebrow">Fundada en familia desde 2018</div>
        <h2 class="section-title">Contratistas de canaletas con experiencia en Tampa</h2>
        <p class="about-lead">
          Fundada en diciembre de 2018, SunLife nació de la visión de Kevin y Jessica Stroh. Lo que
          empezó con un equipo de canaletas seamless creció hasta ser un equipo completo de
          exteriores que sirve al área de Tampa Bay, ofreciendo canaletas seamless, Super Gutters,
          screen rooms, lanais y trim de techo, manteniendo los estimados honestos y la atención al
          detalle que han definido a la empresa desde el inicio.
        </p>
        <ul class="about-list">
          <li>Aluminio seamless fabricado en el camión para un ajuste perfecto</li>
          <li>Soportes resistentes a la corrosión espaciados para el viento de Old Tampa Bay</li>
          <li>Accesorios a color que combinan con stucco, siding o ladrillo</li>
          <li>Servicios de techo disponibles a través de socios locales de confianza</li>
        </ul>
        <div class="about-video-actions">
          <a href={telLink} class="btn btn-primary btn-lg">
            {ES_NAV.callPrefix} {phoneDisplay}
          </a>
          <a href="/es/contacto/#contact" class="btn btn-outline btn-lg request-estimate">
