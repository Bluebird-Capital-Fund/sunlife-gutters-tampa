---
/**
 * Soft first-visit language suggestion on the English homepage only.
 * Bottom-right popup; choice remembered 30 days via localStorage.
 */
---

<div
  id="lang-suggest-banner"
  class="lang-suggest-popup"
  hidden
  role="dialog"
  aria-label="Language suggestion"
  aria-modal="false"
>
  <div class="lang-suggest-popup-inner">
    <p class="lang-suggest-popup-text" lang="en">Prefer to view this site in Spanish?</p>
    <p class="lang-suggest-popup-text lang-suggest-popup-text--es" lang="es">
      ¿Prefiere ver este sitio en español?
    </p>
    <div class="lang-suggest-popup-actions">
      <a href="/es/" class="btn btn-primary lang-suggest-accept" data-lang-suggest="es">
        Ver en Español
      </a>
      <button type="button" class="btn btn-outline lang-suggest-dismiss" data-lang-suggest="en">
        Keep English
      </button>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    var KEY = 'sgt_lang_pref'
    var DAYS = 30
    var popup = document.getElementById('lang-suggest-banner')
    if (!popup) return

    function remember(value) {
      try {
        localStorage.setItem(
          KEY,
          JSON.stringify({ value: value, expires: Date.now() + DAYS * 24 * 60 * 60 * 1000 })
        )
      } catch (e) {}
    }

    function readPref() {
      try {
        var raw = localStorage.getItem(KEY)
        if (!raw) return null
        var parsed = JSON.parse(raw)
        if (!parsed || !parsed.expires || Date.now() > parsed.expires) {
          localStorage.removeItem(KEY)
          return null
        }
        return parsed.value
      } catch (e) {
        return null
      }
    }

    if (readPref()) return
    popup.hidden = false

    popup.querySelectorAll('[data-lang-suggest]').forEach(function (el) {
      el.addEventListener('click', function () {
        var choice = el.getAttribute('data-lang-suggest')
        remember(choice)
        try {
          if (window.dataLayer) {
            window.dataLayer.push({
              event: 'language_switch',
              language_target: choice,
              language_source: 'homepage_popup',
            })
          }
        } catch (e) {}
        if (choice === 'en') popup.hidden = true
      })
    })
  })()
</script>
