---
/**
 * Homepage-style Google reviews summary + testimonials grid.
 */
import { externalLinkAttrs } from '../lib/external-link.js'
import { reviewCountDisplay as canonicalReviewCountDisplay } from '../lib/review-count.js'
import { guttersReviews } from '../lib/lp-gutters-reviews.js'
import { asStr, mediaUrl, statLookup } from '../lib/sanity-strings.js'

const {
  settings,
  homePage,
  headline,
  hideSummaryCta = false,
  limit = 0,
  maxQuoteChars = 160,
} = Astro.props

const reviews = settings?.reviews ?? homePage?.reviews ?? {}
const reviewsSummary = reviews?.summary ?? {}
const reviewValues = reviews?.reviewValues ?? {}
const postedOnFallback = asStr(reviews?.postedOnLabel) || 'Posted on Google'

function stripHtml(html) {
  return String(html || '')
    .replace(/<[^>]*>/g, ' ')
    .replace(/&nbsp;/gi, ' ')
    .replace(/&amp;/gi, '&')
    .replace(/&quot;/gi, '"')
    .replace(/&#39;/gi, "'")
    .replace(/\s+/g, ' ')
    .trim()
}

function truncateQuote(text, maxLen) {
  const clean = stripHtml(text)
  if (!clean || clean.length <= maxLen) return clean
  const sliced = clean.slice(0, maxLen)
  const lastSpace = sliced.lastIndexOf(' ')
  const base = lastSpace > 80 ? sliced.slice(0, lastSpace) : sliced
  return `${base.replace(/[.,;:!\s]+$/g, '')}...`
}

function quoteFromParts(parts) {
  if (!Array.isArray(parts)) return ''
  return parts.map((part) => asStr(part?.t)).join('')
}

function normalizeTestimonial(raw) {
  const quote =
    asStr(raw?.quote) || quoteFromParts(raw?.quoteParts) || stripHtml(asStr(raw?.quoteHtml))
  return {
    author: asStr(raw?.author),
    timeAgo: asStr(raw?.timeAgo) || postedOnFallback,
    avatarSrc: asStr(raw?.avatarSrc),
    quote: truncateQuote(quote, Number(maxQuoteChars) > 0 ? Number(maxQuoteChars) : 160),
  }
}

const cmsTestimonials = (Array.isArray(reviews?.testimonials) ? reviews.testimonials : []).map(
  normalizeTestimonial,
)
const fillerTestimonials = guttersReviews.map((t) =>
  normalizeTestimonial({
    author: t.author,
    avatarSrc: t.avatarSrc,
    quoteHtml: t.quoteHtml,
    timeAgo: postedOnFallback,
  }),
)
const seenAuthors = new Set()
const allTestimonials = [...cmsTestimonials, ...fillerTestimonials].filter((t) => {
  if (!t.quote) return false
  const key = t.author.toLowerCase()
  if (seenAuthors.has(key)) return false
  seenAuthors.add(key)
  return true
})
const maxItems = Number(limit) > 0 ? Number(limit) : cmsTestimonials.length || allTestimonials.length
const testimonials = allTestimonials.slice(0, maxItems)

const reviewRating =
  statLookup(reviewValues, reviewsSummary?.ratingValueKey) || '4.9'
const reviewCount = statLookup(reviewValues, reviewsSummary?.reviewCountKey)
const reviewCountDisplay = canonicalReviewCountDisplay(
  asStr(reviewsSummary?.reviewCountPrefix),
  reviewCount,
  asStr(reviewsSummary?.reviewCountSuffix),
)
const reviewsCtaHref = asStr(reviewsSummary?.ctaHref) || '/reviews/'
const sectionHeadline = asStr(headline) || 'See Why So Many Homeowners Choose Us'
const showSummaryCta = !hideSummaryCta && Boolean(asStr(reviewsSummary?.ctaText))
const hasSummary =
  asStr(reviewsSummary?.googleIconSrc) ||
  asStr(reviewsSummary?.brandLabel) ||
  asStr(reviewRating) ||
  asStr(reviewCount)
---

{
  testimonials.length > 0 || hasSummary ? (
    <section id="reviews" class="section google-reviews">
      <div class="container">
        <h2
          class:list={[
            'section-title',
            'reviews-title',
            { 'reviews-title-compact': Boolean(asStr(headline).trim()) },
          ]}
        >
          {sectionHeadline}
        </h2>
        {hasSummary ? (
          <div class="reviews-summary" data-reviews-summary-box>
            <div class="reviews-summary-left">
              <p class="reviews-summary-brand">
                {asStr(reviewsSummary?.googleIconSrc) ? (
                  <img
                    src={mediaUrl(asStr(reviewsSummary.googleIconSrc))}
                    alt={asStr(reviewsSummary?.brandLabel) || 'Google'}
                    class="google-logo"
                    width="20"
                    height="20"
                    loading="lazy"
                    decoding="async"
                  />
                ) : null}
                <span>{asStr(reviewsSummary?.brandLabel) || 'Google'}</span>
              </p>
              <p class="reviews-summary-rating">
                <strong>{reviewRating}</strong>
                {asStr(reviewsSummary?.starsImageSrc) ? (
                  <img
                    src={mediaUrl(asStr(reviewsSummary.starsImageSrc))}
                    alt={asStr(reviewsSummary?.starsImageAlt) || '5 star rating'}
                    class="review-stars review-stars-inline"
                    width="96"
                    height="18"
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <span class="review-stars-text" aria-hidden="true">
                    ★★★★★
                  </span>
                )}
                <span>{reviewCountDisplay}</span>
              </p>
            </div>
            {showSummaryCta ? (
              <a
                href={reviewsCtaHref}
                class="btn btn-outline btn-lg request-estimate reviews-summary-cta"
                {...externalLinkAttrs(reviewsCtaHref)}
              >
                {asStr(reviewsSummary.ctaText)}
              </a>
            ) : null}
          </div>
        ) : null}
        {testimonials.length > 0 ? (
          <div class="testimonials-grid">
            {testimonials.map((t) => (
              <blockquote class="testimonial">
                <div class="review-brand review-brand-top">
                  {asStr(t?.avatarSrc) ? (
                    <img
                      src={mediaUrl(asStr(t.avatarSrc))}
                      alt={asStr(t?.author)}
                      class="review-avatar"
                      width="48"
                      height="48"
                      loading="lazy"
                      decoding="async"
                    />
                  ) : null}
                  <div class="review-meta">
                    <strong>{asStr(t?.author)}</strong>
                    <span class="review-time">{asStr(t?.timeAgo)}</span>
                  </div>
                </div>
                {asStr(reviewsSummary?.starsImageSrc) ? (
                  <img
                    src={mediaUrl(asStr(reviewsSummary.starsImageSrc))}
                    alt={asStr(reviewsSummary?.starsImageAlt) || '5 star rating'}
                    class="review-stars"
                    width="96"
                    height="18"
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <div class="review-stars-text" aria-label="5 star review">
                    ★★★★★
                  </div>
                )}
                <p>&quot;{asStr(t?.quote)}&quot;</p>
                <div class="review-posted-on">
                  {asStr(reviewsSummary?.googleIconSrc) ? (
                    <img
                      src={mediaUrl(asStr(reviewsSummary.googleIconSrc))}
                      alt={asStr(reviewsSummary?.brandLabel) || 'Google'}
                      class="google-logo"
                      width="20"
                      height="20"
                      loading="lazy"
                      decoding="async"
                    />
                  ) : null}
                  <span>{postedOnFallback}</span>
                </div>
              </blockquote>
            ))}
          </div>
        ) : null}
      </div>
    </section>
  ) : null
}
