---
/**
 * Desktop white-bar Call + language switcher.
 * Place as a sibling AFTER </nav> in .header-inner (not inside .nav).
 * Mobile uses HeaderNavActions + .nav-call-drawer inside the open menu.
 */
import LanguageSwitcher from './LanguageSwitcher.astro'

interface Props {
  telHref: string
  callLabel: string
}

const { telHref, callLabel } = Astro.props
const href = String(telHref || '').trim() || '#'
---

<div class="nav-call-row">
  <a href={href} class="btn btn-primary btn-lg">{callLabel}</a>
  <LanguageSwitcher />
</div>
