---
/**
 * Nav Call CTA — place inside .nav (last item).
 * Language switcher lives in the offer-bar / HeaderNavActions.
 */
interface Props {
  telHref: string
  callLabel: string
}

const { telHref, callLabel } = Astro.props
const href = String(telHref || '').trim() || '#'
---

<a href={href} class="btn btn-primary btn-lg">{callLabel}</a>
