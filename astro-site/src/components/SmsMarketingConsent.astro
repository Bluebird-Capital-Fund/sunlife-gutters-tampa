---
interface Props {
  /** Unique id for the checkbox (and label association). */
  checkboxId: string
  /** Optional locale for consent copy (en | es). */
  locale?: string
  /** Shorter consent copy for tight hero forms. */
  compact?: boolean
}

const { checkboxId, locale = 'en', compact = false } = Astro.props
const isEs = locale === 'es' || locale === 'es-US'
---

<div class="lead-form-sms-consent">
  <label class="lead-form-sms-consent-label" for={checkboxId}>
    <input
      type="checkbox"
      id={checkboxId}
      name="smsMarketingConsent"
      value="yes"
      required
    />
    <span class="lead-form-sms-consent-text">
      <span class="required-mark" aria-hidden="true">*</span>
      {isEs ? (
        compact ? (
          <>
            Consiento recibir SMS de SunLife Gutters Tampa.
            <a class="lead-form-sms-consent-link" href="/privacy-policy/">Privacidad</a>
            {' · '}
            <a class="lead-form-sms-consent-link" href="/terms-of-service/">Términos</a>
            . Msg/datos pueden aplicar. STOP para cancelar.
          </>
        ) : (
          <>
            Consiento recibir SMS de SunLife Gutters Tampa (Bluebird Miami, LLC) en mi número. Consulte nuestra
            <a class="lead-form-sms-consent-link" href="/privacy-policy/">Política de privacidad</a>
            y los
            <a class="lead-form-sms-consent-link" href="/terms-of-service/">Términos del servicio</a>. Pueden aplicar
            tarifas de mensajes/datos. Responda STOP para cancelar.
          </>
        )
      ) : (
        <>
          I consent to SMS from SunLife Gutters Tampa (Bluebird Miami, LLC) at my number. See our
          <a class="lead-form-sms-consent-link" href="/privacy-policy/">Privacy Policy</a>
          and
          <a class="lead-form-sms-consent-link" href="/terms-of-service/">Terms of Service</a>. Msg/data rates may
          apply. Reply STOP to opt out.
        </>
      )}
    </span>
  </label>
</div>
