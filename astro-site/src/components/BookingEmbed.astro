---
import { BOOKING_WIDGET_ID, BOOKING_WIDGET_SRC } from '../lib/booking-cta.js'

const iframeId = `${BOOKING_WIDGET_ID}_1794351008415`
---

<div class="booking-embed">
  <iframe
    src={BOOKING_WIDGET_SRC}
    allow="payment"
    id={iframeId}
    title="Schedule a free on-site estimate"
    style="width:100%;border:none;overflow:hidden;"
    scrolling="no"></iframe>
</div>
<script is:inline src="https://link.msgsndr.com/js/form_embed.js" type="text/javascript"></script>
