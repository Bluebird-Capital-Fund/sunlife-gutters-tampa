---
import BaseLayout from '../../layouts/BaseLayout.astro'
import FooterSocialIcon from '../../components/FooterSocialIcon.astro'
import FooterHoursRow from '../../components/FooterHoursRow.astro'
import FooterSmsDisclosure from '../../components/FooterSmsDisclosure.astro'
import FooterFinancingDisclosure from '../../components/FooterFinancingDisclosure.astro'
import FooterContactInfo from '../../components/FooterContactInfo.astro'
import SmsMarketingConsent from '../../components/SmsMarketingConsent.astro'
import HeaderNavActions from '../../components/HeaderNavActions.astro'
import LanguageSwitcher from '../../components/LanguageSwitcher.astro'
import Breadcrumbs from '../../components/Breadcrumbs.astro'
import { simpleBreadcrumbItems } from '../../lib/breadcrumbs.js'
import { externalLinkAttrs } from '../../lib/external-link.js'
import { googleBusinessProfileUrl, isContactFooterColumnHeading } from '../../lib/footer-contact-heading.js'
import { sanity } from '../../lib/sanity.js'
import { getSiteSettings, getHomePage, mergeHeaderFromSettings } from '../../lib/site-settings.js'
import { projectImagePool } from '../../lib/hero-backgrounds.js'
import { asStr, applyTemplate, mediaUrl } from '../../lib/sanity-strings.js'

let settings = {}
let homePage = {}
let galleryPages = []
try {
  ;[settings, homePage, galleryPages] = await Promise.all([
    getSiteSettings(),
    getHomePage(),
    sanity.fetch(
      `*[_type == "galleryPage"]{
        headline,
        lead,
        "slug": slug.current,
        images
      }`
    ),
  ])
} catch (err) {
  console.warn('[gallery] Sanity fetch failed; using fallback placeholders.', err)
}

const business = settings?.business ?? {}
const header = mergeHeaderFromSettings(settings, homePage?.header)
const footerEstimate = settings?.footerEstimate ?? homePage?.footerEstimate ?? {}
const footerEstimateFields = footerEstimate?.formFields ?? {}
const formsCfg = settings?.forms ?? {}
const footerBrand = settings?.footerBrand ?? homePage?.footerBrand ?? {}
const footerColumns = settings?.footerColumns ?? homePage?.footerColumns ?? []
const footerSupport = settings?.footerSupport ?? homePage?.footerSupport ?? {}

const companyName = asStr(business.companyName) || 'SGT'
const phoneDisplay = asStr(business.phoneDisplay) || '(303) 000-0000'
const phoneTel = asStr(business.phoneTel) || '3030000000'
const email = asStr(business.email) || 'hello@example.com'
const address = asStr(business.addressShort) || 'Tampa, Colorado'
const addressHref = googleBusinessProfileUrl(settings)
const descriptionShort = asStr(business.descriptionShort)
const logoWhite = asStr(business.logoHorizontalWhite)
const logoBlack = asStr(business.logoHorizontalBlack)
const copyrightHref = asStr(business.copyrightSiteUrl) || '#'

const callLabelNav = applyTemplate(asStr(header.callCtaTemplate), { phoneDisplay }) || phoneDisplay
const logoAriaLabel = applyTemplate(asStr(header.logoAriaLabelTemplate), { companyName }) || companyName
const navItems = Array.isArray(header.navItems) ? header.navItems : []

const looksLegacyColorado = (value) => {
  const text = asStr(value).toLowerCase()
  if (!text) return false
  return (
    text.includes('mile high') ||
    text.includes('denver') ||
    text.includes('colorado') ||
    text.includes(', co') ||
    text.includes('-co-') ||
    text.includes('/images (mile high)/')
  )
}

const isSunLifeProjectImage = (src) => {
  const value = asStr(src).toLowerCase()
  if (!value) return false
  return value.includes('/images (sgt)/') || value.includes('media (sgt)/images (sgt)/') || value.includes('sunlife-')
}

const cleanProjectText = (value, fallback = '') => {
  const text = asStr(value).trim()
  if (!text) return fallback
  if (!looksLegacyColorado(text)) return text
  return fallback
}

const CITY_FL_SPECIAL = {
  'st-petersburg': 'St. Petersburg',
  'saint-petersburg': 'St. Petersburg',
  'land-o-lakes': "Land O' Lakes",
  'anna-maria-island': 'Anna Maria Island',
  'sun-city-center': 'Sun City Center',
  'lakewood-ranch': 'Lakewood Ranch',
  'longboat-key': 'Longboat Key',
  'wesley-chapel': 'Wesley Chapel',
  'apollo-beach': 'Apollo Beach',
  'plant-city': 'Plant City',
  'dade-city': 'Dade City',
  'new-tampa': 'New Tampa',
}

/** Longest-first so multi-word cities match before single tokens. */
const CITY_FL_SLUGS = [
  'anna-maria-island',
  'sun-city-center',
  'lakewood-ranch',
  'land-o-lakes',
  'longboat-key',
  'st-petersburg',
  'saint-petersburg',
  'wesley-chapel',
  'apollo-beach',
  'plant-city',
  'dade-city',
  'new-tampa',
  'clearwater',
  'bradenton',
  'gibsonton',
  'ellenton',
  'zephyrhills',
  'thonotosassa',
  'lakeland',
  'valrico',
  'riverview',
  'brandon',
  'seffner',
  'wimauma',
  'lithia',
  'cortez',
  'odessa',
  'ruskin',
  'dover',
  'largo',
  'lutz',
  'tampa',
]

const titleCaseCitySlug = (slug) => {
  if (CITY_FL_SPECIAL[slug]) return CITY_FL_SPECIAL[slug]
  return String(slug || '')
    .split('-')
    .filter(Boolean)
    .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
    .join(' ')
}

/** Photo captions: only "City, FL". */
const cityFlCaption = (...candidates) => {
  for (const raw of candidates) {
    const text = asStr(raw).trim()
    if (!text) continue
    const already = text.match(/^(.+?),\s*FL\s*$/i)
    if (already && !/\s[-–—]/.test(already[1]) && already[1].split(/\s+/).length <= 4) {
      const city = already[1].trim()
      if (city && !/tampa bay|metro|area|project/i.test(city)) return `${city}, FL`
    }
  }

  const haystack = candidates.map((v) => asStr(v).toLowerCase()).join(' ')
  const file = asStr(candidates[0] || '')
    .split('/')
    .pop()
    .toLowerCase()
  const searchIn = `${file} ${haystack}`

  for (const slug of CITY_FL_SLUGS) {
    const spaced = slug.replace(/-/g, ' ')
    if (
      searchIn.includes(`-${slug}-`) ||
      searchIn.includes(`-${slug}.`) ||
      searchIn.includes(`${slug}-fl`) ||
      searchIn.includes(` ${spaced} `) ||
      searchIn.includes(` ${spaced},`) ||
      searchIn.startsWith(`${slug}-`) ||
      searchIn.includes(`gutters-${slug}`)
    ) {
      return `${titleCaseCitySlug(slug)}, FL`
    }
  }

  return 'Tampa, FL'
}

const allGalleryPages = Array.isArray(galleryPages) ? galleryPages : []
const primaryGalleryPage =
  allGalleryPages.find((p) => asStr(p?.slug) === 'gallery') ??
  allGalleryPages.find((p) => asStr(p?.slug) === 'projects') ??
  allGalleryPages[0] ??
  {}

const cmsHeadline = cleanProjectText(primaryGalleryPage?.headline, '')
const pageTitle =
  !cmsHeadline || /^projects\b/i.test(cmsHeadline) ? 'Gallery | SunLife Gutters' : `${cmsHeadline} | SunLife Gutters`
const pageDescription = cleanProjectText(
  primaryGalleryPage?.lead,
  'Photo gallery of completed gutter work across Tampa Bay.'
)
const galleryImages = allGalleryPages.flatMap((p) => (Array.isArray(p?.images) ? p.images : []))
const homeProjectSlides = Array.isArray(homePage?.projects?.slides) ? homePage.projects.slides : []
const folderProjectImages = projectImagePool.map((src) => {
  const location = cityFlCaption(src)
  return {
    imageSrc: src,
    imageAlt: `${location} gutter project`,
    location,
  }
})
const allProjectImages = [...galleryImages, ...homeProjectSlides, ...folderProjectImages]
const seenImageSrc = new Set()
const images = allProjectImages
  .filter((img) => {
    const src = asStr(img?.imageSrc)
    const alt = asStr(img?.imageAlt)
    const location = asStr(img?.location)
    if (!src || seenImageSrc.has(src)) return false
    if (!isSunLifeProjectImage(src)) return false
    if (looksLegacyColorado(src) || looksLegacyColorado(alt) || looksLegacyColorado(location)) return false
    seenImageSrc.add(src)
    return true
  })
  .map((img) => {
    const location = cityFlCaption(img.imageSrc, img.location, img.imageAlt)
    return {
      ...img,
      location,
      imageAlt: `${location} gutter project`,
    }
  })

/** Client-side lightbox (serialized in page script) */
const galleryItems = images.map((img) => ({
  src: mediaUrl(asStr(img.imageSrc)),
  alt: asStr(img.imageAlt) || 'Gutter project photo',
  caption: asStr(img.location) || 'Tampa, FL',
}))

const universalFormFields = footerEstimateFields
const universalFormAction = asStr(formsCfg?.submitPath) || asStr(footerEstimate?.formAction) || '#'
const universalFormMethod = asStr(footerEstimate?.formMethod) || 'post'
const universalRequiredIndicator = asStr(formsCfg?.requiredIndicator) || '*'
const breadcrumbItems = simpleBreadcrumbItems('Gallery')
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  theme={settings?.theme}
  forms={{ submitPath: asStr(settings?.forms?.submitPath) || '/api/lead' }}
>
  <header class="header">
    <div class="offer-bar"><div class="offer-bar-inner"><p class="offer-message">{asStr(header?.offerBar?.textBeforeDiscount)}<strong>{asStr(header?.offerBar?.discountLabel)}</strong>{asStr(header?.offerBar?.textAfterDiscount)} <a href={asStr(header?.offerBar?.ctaHref) || '#contact'} class="offer-link"><strong>{asStr(header?.offerBar?.ctaText) || 'Get a Quote Now!'}</strong></a></p></div></div>
    <div class="header-nav">
      <div class="header-inner">
        <a href="/" class="logo" aria-label={logoAriaLabel}>{logoBlack ? <img src={mediaUrl(logoBlack)} alt={companyName} class="logo-img" /> : <span class="section-title" style="margin:0; font-size: 1.25rem;">{companyName}</span>}</a>
        <HeaderNavActions telHref={`tel:${phoneTel}`} phoneDisplay={phoneDisplay} />
        <nav class="nav">
          {navItems.length > 0 ? (
            navItems.map((item, i) => {
              const label = asStr(item.label)
              const href = asStr(item.href)
              const dropdown = item.dropdown
              if (Array.isArray(dropdown) && dropdown.length > 0) {
                const ddId = `gallery-nav-dd-${i}`
                return (
                  <div class="nav-dropdown" data-nav-dropdown>
                    <button
                      type="button"
                      class="nav-dropdown-toggle"
                      aria-expanded="false"
                      aria-haspopup="true"
                      aria-controls={ddId}
                      id={`${ddId}-btn`}
                    >
                      {label}
                      <span class="nav-dropdown-chevron" aria-hidden="true"></span>
                    </button>
                    <ul class="nav-dropdown-menu" id={ddId} role="menu">
                      {dropdown.map((link) => (
                        <li role="none">
                          <a href={asStr(link.href)} role="menuitem">
                            {asStr(link.label)}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                )
              }
              return <a href={href || '#'}>{label}</a>
            })
          ) : (
            <>
              <a href="/">Home</a>
              <a href="/seamless-gutters-tampa-fl/">Products & Services</a>
            </>
          )}
          <LanguageSwitcher />
          <a href={`tel:${phoneTel}`} class="btn btn-primary btn-lg">{callLabelNav}</a>
        </nav>
      </div>
    </div>
  </header>

  <main>
    <Breadcrumbs items={breadcrumbItems} />
    <section class="section secondary-page-section" aria-labelledby="gallery-intro-heading">
      <div class="container page-split page-split--media-end">
        <div class="secondary-prose">
          <h1 class="section-title section-title-secondary" id="gallery-intro-heading">Gallery across Tampa Bay</h1>
          <p>
            Take a look at some of the projects we've completed for homeowners and businesses across Tampa Bay. From seamless gutters and Super Gutters to exterior upgrades, every project reflects the quality workmanship, attention to detail, and care we're known for. Each photo is taken after the final walkthrough, once the job is complete and the work area has been cleaned.
          </p>
          <p>
            Click any photo to view it in full screen and browse our recent projects. On mobile, simply swipe to explore the gallery.
          </p>
          <p>
            Have a project in mind? During your free consultation, we'll answer your questions, explain your options, and recommend the right solution for your home.
          </p>
        </div>
        <figure class="page-split__media">
          <img
            src={mediaUrl('Media (SGT)/Images (SGT)/sunlife-gutters-brandon-fl-front-entry-gutters.webp')}
            alt="Front entry gutters and downspouts on a Brandon, FL home"
            width="640"
            height="480"
            loading="lazy"
            decoding="async"
          />
        </figure>
      </div>
    </section>

    <section class="section projects-gallery-section">
      <div class="container">
        {images.length > 0 ? (
          <>
            <p class="projects-gallery-hint">Click a photo to view larger. Use arrows or keyboard to browse.</p>
            <div class="projects-gallery-grid">
              {images.map((img, i) => (
                <button
                  type="button"
                  class="projects-gallery-thumb"
                  data-photo-index={i}
                  aria-label={`Open project photo ${i + 1} of ${images.length} in gallery viewer`}
                >
                  <span class="projects-gallery-thumb-img-wrap">
                    <img
                      src={mediaUrl(asStr(img.imageSrc))}
                      alt=""
                      loading="lazy"
                      decoding="async"
                      width="640"
                      height="480"
                    />
                  </span>
                  <span class="projects-gallery-thumb-caption">{asStr(img.location) || 'Tampa, FL'}</span>
                </button>
              ))}
            </div>

            <div
              id="projects-lightbox"
              class="projects-lightbox"
              hidden
              role="dialog"
              aria-modal="true"
              aria-label="Project photo gallery"
            >
              <button
                type="button"
                class="projects-lightbox-backdrop"
                data-lightbox-close
                tabindex="-1"
                aria-label="Close gallery"
              />
              <div class="projects-lightbox-panel">
                <button type="button" class="projects-lightbox-close" data-lightbox-close aria-label="Close gallery">
                  <span aria-hidden="true">×</span>
                </button>
                <p class="projects-lightbox-index" aria-live="polite" />
                <button type="button" class="projects-lightbox-nav projects-lightbox-prev" aria-label="Previous photo">
                  <span aria-hidden="true">‹</span>
                </button>
                <figure class="projects-lightbox-figure">
                  <img class="projects-lightbox-img" src="" alt="" />
                  <figcaption class="projects-lightbox-caption" />
                </figure>
                <button type="button" class="projects-lightbox-nav projects-lightbox-next" aria-label="Next photo">
                  <span aria-hidden="true">›</span>
                </button>
              </div>
            </div>
          </>
        ) : (
          <p>No project images added yet.</p>
        )}
      </div>
    </section>
  </main>

  <footer class="footer">
    <section id="contact" class="section contact footer-estimate">
      <div class="container">
        <div class="contact-wrapper">
          <div class="contact-info">
            <h2 class="section-title">{asStr(footerEstimate?.headline) || 'Need Gutter Help in Tampa?'}</h2>
            <p>{asStr(footerEstimate?.intro) || 'Start with a free consultation and get honest recommendations and transparent pricing from a team Tampa Bay homeowners trust.'}</p>
            <FooterContactInfo variant="estimate" phoneTel={phoneTel} phoneDisplay={phoneDisplay} email={email} address={address} addressHref={addressHref} />
          </div>
          <form class="contact-form" data-lead-form="gallery-footer" action={universalFormAction} method={universalFormMethod}>
            <div class="contact-form-grid">
              <div class="contact-form-field"><label for="contact-name">{asStr(universalFormFields?.nameLabel) || 'Name'} <span class="required-mark" aria-hidden="true">{universalRequiredIndicator}</span></label><input id="contact-name" name="name" type="text" required autocomplete="name" /></div>
              <div class="contact-form-field"><label for="contact-email">{asStr(universalFormFields?.emailLabel) || 'Email'} <span class="required-mark" aria-hidden="true">{universalRequiredIndicator}</span></label><input id="contact-email" name="email" type="email" required autocomplete="email" /></div>
              <div class="contact-form-field"><label for="contact-phone">{asStr(universalFormFields?.phoneLabel) || 'Phone'} <span class="required-mark" aria-hidden="true">{universalRequiredIndicator}</span></label><input id="contact-phone" name="phone" type="tel" required autocomplete="tel" /></div>
              <div class="contact-form-field"><label for="contact-location">{asStr(universalFormFields?.cityLabel) || 'City'}</label><input id="contact-location" name="location" type="text" autocomplete="address-level2" /></div>
              <div class="contact-form-field contact-form-field-full"><label for="contact-message">{asStr(universalFormFields?.projectDetailsLabel) || 'Project Details'}</label><textarea id="contact-message" name="message" rows="4"></textarea></div>
            </div>
            <SmsMarketingConsent checkboxId="gallery-footer-sms-consent" />
            <button type="submit" class="btn btn-primary btn-lg">Submit</button>
          </form>
        </div>
      </div>
    </section>
    <div class="container"><div class="footer-inner"><div class="footer-brand-block footer-col">{logoWhite ? <img src={mediaUrl(logoWhite)} alt={companyName} class="footer-logo" /> : null}<p class="footer-address">{descriptionShort}</p><div class="footer-social" aria-label={asStr(footerBrand?.socialAriaLabel)}>{footerBrand?.socialLinks?.map((s) => (<a href={asStr(s.href)} aria-label={asStr(s.ariaLabel)} {...externalLinkAttrs(asStr(s.href))}><FooterSocialIcon platform={asStr(s.platform)} /></a>))}</div></div>{footerColumns?.map((col) => (<div class="footer-col"><p class="footer-heading">{asStr(col.heading)}</p>{col.links?.length ? (<nav class="footer-links" aria-label={asStr(col.ariaLabel)}>{col.links.map((link) => (<a href={asStr(link.href)} {...externalLinkAttrs(asStr(link.href))}>{asStr(link.label)}</a>))}</nav>) : null}{isContactFooterColumnHeading(col.heading) ? <FooterContactInfo variant="footer-column" phoneTel={phoneTel} phoneDisplay={phoneDisplay} email={email} address={address} addressHref={addressHref} /> : null}{col.hoursHeading ? <p class="footer-heading footer-hours-heading">{asStr(col.hoursHeading)}</p> : null}{col.hoursText ? <FooterHoursRow hoursText={col.hoursText} /> : null}{(col.hoursHeading || col.hoursText) ? <FooterSmsDisclosure /> : null}</div>))}</div></div>
  </footer>

  <FooterFinancingDisclosure />

  <div class="footer-support"><div class="container footer-support-inner"><p>© <span id="year"></span> — <a href={copyrightHref} {...externalLinkAttrs(copyrightHref)}>{companyName}</a></p><nav aria-label={asStr(footerSupport?.ariaLabel)}>{footerSupport?.links?.map((link) => (<a href={asStr(link.href)} {...externalLinkAttrs(asStr(link.href))}>{asStr(link.label)}</a>))}</nav></div></div>

  {galleryItems.length > 0 ? (
    <script define:vars={{ galleryItems }}>
      (function () {
        var items = galleryItems
        if (!items || !items.length) return

        var root = document.getElementById('projects-lightbox')
        if (!root) return

        var imgEl = root.querySelector('.projects-lightbox-img')
        var capEl = root.querySelector('.projects-lightbox-caption')
        var idxEl = root.querySelector('.projects-lightbox-index')
        var btnPrev = root.querySelector('.projects-lightbox-prev')
        var btnNext = root.querySelector('.projects-lightbox-next')
        var closeBtns = root.querySelectorAll('[data-lightbox-close]')

        var current = 0

        function show(i) {
          var n = items.length
          if (n === 0) return
          current = ((i % n) + n) % n
          var item = items[current]
          imgEl.src = item.src
          imgEl.alt = item.alt
          capEl.textContent = item.caption || ''
          if (idxEl) idxEl.textContent = String(current + 1) + ' / ' + n
        }

        function open(at) {
          show(at)
          root.hidden = false
          document.body.style.overflow = 'hidden'
          var closeBtn = root.querySelector('.projects-lightbox-close')
          if (closeBtn) closeBtn.focus()
        }

        function close() {
          root.hidden = true
          document.body.style.overflow = ''
        }

        document.querySelectorAll('.projects-gallery-thumb').forEach(function (btn) {
          btn.addEventListener('click', function () {
            var i = parseInt(btn.getAttribute('data-photo-index'), 10)
            open(isNaN(i) ? 0 : i)
          })
        })

        btnPrev.addEventListener('click', function (e) {
          e.stopPropagation()
          show(current - 1)
        })
        btnNext.addEventListener('click', function (e) {
          e.stopPropagation()
          show(current + 1)
        })
        closeBtns.forEach(function (b) {
          b.addEventListener('click', function () {
            close()
          })
        })

        document.addEventListener('keydown', function (e) {
          if (root.hidden) return
          if (e.key === 'Escape') {
            e.preventDefault()
            close()
          } else if (e.key === 'ArrowLeft') {
            e.preventDefault()
            show(current - 1)
          } else if (e.key === 'ArrowRight') {
            e.preventDefault()
            show(current + 1)
          }
        })
      })()
    </script>
  ) : null}
</BaseLayout>
