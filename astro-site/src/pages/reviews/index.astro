---
import BaseLayout from '../../layouts/BaseLayout.astro'
import FooterSocialIcon from '../../components/FooterSocialIcon.astro'
import FooterHoursRow from '../../components/FooterHoursRow.astro'
import FooterSmsDisclosure from '../../components/FooterSmsDisclosure.astro'
import FooterFinancingDisclosure from '../../components/FooterFinancingDisclosure.astro'
import FooterContactInfo from '../../components/FooterContactInfo.astro'
import SmsMarketingConsent from '../../components/SmsMarketingConsent.astro'
import HeaderNavActions from '../../components/HeaderNavActions.astro'
import Breadcrumbs from '../../components/Breadcrumbs.astro'
import { simpleBreadcrumbItems } from '../../lib/breadcrumbs.js'
import { externalLinkAttrs } from '../../lib/external-link.js'
import { googleBusinessProfileUrl, isContactFooterColumnHeading } from '../../lib/footer-contact-heading.js'
import { sanity } from '../../lib/sanity.js'
import { getSiteSettings, getHomePage, mergeHeaderFromSettings } from '../../lib/site-settings.js'
import { asStr, applyTemplate, mediaUrl, statLookup } from '../../lib/sanity-strings.js'
import { gutterGuardsReviews } from '../../lib/lp-gutter-guards-reviews.js'
import { gutterInstallationReviews } from '../../lib/lp-gutter-installation-reviews.js'
import { gutterRepairReviews } from '../../lib/lp-gutter-repair-reviews.js'
import { guttersReviews } from '../../lib/lp-gutters-reviews.js'

let settings = {}
let homePage = {}
let reviewsPage = {}
try {
  ;[settings, homePage, reviewsPage] = await Promise.all([
    getSiteSettings(),
    getHomePage(),
    sanity.fetch(`*[_type == "reviewsPage" && slug.current == "reviews"][0]`),
  ])
} catch (err) {
  console.warn('[reviews] Sanity fetch failed; using fallback placeholders.', err)
}

const business = settings?.business ?? {}
const header = mergeHeaderFromSettings(settings, homePage?.header)
const footerEstimate = settings?.footerEstimate ?? homePage?.footerEstimate ?? {}
const footerEstimateFields = footerEstimate?.formFields ?? {}
const formsCfg = settings?.forms ?? {}
const footerBrand = settings?.footerBrand ?? homePage?.footerBrand ?? {}
const footerColumns = settings?.footerColumns ?? homePage?.footerColumns ?? []
const footerSupport = settings?.footerSupport ?? homePage?.footerSupport ?? {}

const companyName = asStr(business.companyName) || 'SGT'
const phoneDisplay = asStr(business.phoneDisplay) || '(303) 000-0000'
const phoneTel = asStr(business.phoneTel) || '3030000000'
const email = asStr(business.email) || 'hello@example.com'
const address = asStr(business.addressShort) || 'Tampa, Colorado'
const addressHref = googleBusinessProfileUrl(settings)
const descriptionShort = asStr(business.descriptionShort)
const logoWhite = asStr(business.logoHorizontalWhite)
const logoBlack = asStr(business.logoHorizontalBlack)
const copyrightHref = asStr(business.copyrightSiteUrl) || '#'

const callLabelNav = applyTemplate(asStr(header.callCtaTemplate), { phoneDisplay }) || phoneDisplay
const logoAriaLabel = applyTemplate(asStr(header.logoAriaLabelTemplate), { companyName }) || companyName
const navItems = Array.isArray(header.navItems) ? header.navItems : []

const pageTitle = asStr(reviewsPage?.headline) || 'Reviews | SGT'
const pageDescription = asStr(reviewsPage?.lead) || 'Customer reviews from SGT.'

const reviewsData = settings?.reviews ?? homePage?.reviews ?? {}
const reviewSummary = reviewsData?.summary ?? {}
const reviewValues = reviewsData?.reviewValues ?? {}
const existingTestimonials = Array.isArray(reviewsData?.testimonials) ? reviewsData.testimonials : []
/** Existing site testimonials first, then LP reviews (with bold highlights). */
const testimonials = [
  ...existingTestimonials.map((t) => ({
    author: asStr(t.author),
    avatarSrc: asStr(t.avatarSrc),
    timeAgo: asStr(t.timeAgo),
    quoteHtml: '',
    quote: asStr(t.quote),
  })),
  ...gutterGuardsReviews.map((t) => ({
    author: asStr(t.author),
    avatarSrc: asStr(t.avatarSrc),
    timeAgo: asStr(t.timeAgo),
    quoteHtml: t.quoteHtml,
    quote: '',
  })),
  ...gutterInstallationReviews.map((t) => ({
    author: asStr(t.author),
    avatarSrc: asStr(t.avatarSrc),
    timeAgo: asStr(t.timeAgo),
    quoteHtml: t.quoteHtml,
    quote: '',
  })),
  ...gutterRepairReviews.map((t) => ({
    author: asStr(t.author),
    avatarSrc: asStr(t.avatarSrc),
    timeAgo: asStr(t.timeAgo),
    quoteHtml: t.quoteHtml,
    quote: '',
  })),
  ...guttersReviews.map((t) => ({
    author: asStr(t.author),
    avatarSrc: asStr(t.avatarSrc),
    timeAgo: asStr(t.timeAgo),
    quoteHtml: t.quoteHtml,
    quote: '',
  })),
]
const reviewRating = statLookup(reviewValues, reviewSummary?.ratingValueKey)
const reviewCount = statLookup(reviewValues, reviewSummary?.reviewCountKey)
const reviewCountDisplay = `${asStr(reviewSummary?.reviewCountPrefix)}${reviewCount}${asStr(reviewSummary?.reviewCountSuffix)}`
const reviewsCtaHref = '#contact'

const universalFormFields = footerEstimateFields
const universalFormAction = asStr(formsCfg?.submitPath) || asStr(footerEstimate?.formAction) || '#'
const universalFormMethod = asStr(footerEstimate?.formMethod) || 'post'
const universalRequiredIndicator = asStr(formsCfg?.requiredIndicator) || '*'
const breadcrumbItems = simpleBreadcrumbItems('Reviews')
---

<BaseLayout title={pageTitle} description={pageDescription} theme={settings?.theme} forms={{ submitPath: asStr(settings?.forms?.submitPath) || '/api/lead' }}>
  <header class="header">
    <div class="offer-bar"><div class="offer-bar-inner"><p class="offer-message">{asStr(header?.offerBar?.textBeforeDiscount)}<strong>{asStr(header?.offerBar?.discountLabel)}</strong>{asStr(header?.offerBar?.textAfterDiscount)} <a href={asStr(header?.offerBar?.ctaHref) || '#contact'} class="offer-link"><strong>{asStr(header?.offerBar?.ctaText) || 'Get a Quote Now!'}</strong></a></p></div></div>
    <div class="header-nav">
      <div class="header-inner">
        <a href="/" class="logo" aria-label={logoAriaLabel}>{logoBlack ? <img src={mediaUrl(logoBlack)} alt={companyName} class="logo-img" /> : <span class="section-title" style="margin:0; font-size: 1.25rem;">{companyName}</span>}</a>
        <HeaderNavActions telHref={`tel:${phoneTel}`} phoneDisplay={phoneDisplay} />
        <nav class="nav">
          {navItems.length > 0 ? (
            navItems.map((item, i) => {
              const label = asStr(item.label)
              const href = asStr(item.href)
              const dropdown = item.dropdown
              if (Array.isArray(dropdown) && dropdown.length > 0) {
                const ddId = `reviews-nav-dd-${i}`
                return (
                  <div class="nav-dropdown" data-nav-dropdown>
                    <button
                      type="button"
                      class="nav-dropdown-toggle"
                      aria-expanded="false"
                      aria-haspopup="true"
                      aria-controls={ddId}
                      id={`${ddId}-btn`}
                    >
                      {label}
                      <span class="nav-dropdown-chevron" aria-hidden="true"></span>
                    </button>
                    <ul class="nav-dropdown-menu" id={ddId} role="menu">
                      {dropdown.map((link) => (
                        <li role="none">
                          <a href={asStr(link.href)} role="menuitem">
                            {asStr(link.label)}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                )
              }
              return <a href={href || '#'}>{label}</a>
            })
          ) : (
            <>
              <a href="/">Home</a>
              <a href="/seamless-gutters-tampa-fl/">Products & Services</a>
            </>
          )}
          <a href={`tel:${phoneTel}`} class="btn btn-primary btn-lg">{callLabelNav}</a>
        </nav>
      </div>
    </div>
  </header>

  <main>
    <Breadcrumbs items={breadcrumbItems} />
    <section class="section google-reviews">
      <div class="container">
        <h1 class="section-title reviews-title">What Tampa Bay Neighbors Say</h1>
        <div class="reviews-summary">
          <div class="reviews-summary-left">
            <p class="reviews-summary-brand">
              <img
                src={mediaUrl(asStr(reviewSummary?.googleIconSrc))}
                alt={asStr(reviewSummary?.brandLabel)}
                class="google-logo"
              />
              <span>{asStr(reviewSummary?.brandLabel)}</span>
            </p>
            <p class="reviews-summary-rating">
              <strong>{reviewRating}</strong>
              <img
                src={mediaUrl(asStr(reviewSummary?.starsImageSrc))}
                alt={asStr(reviewSummary?.starsImageAlt)}
                class="review-stars review-stars-inline"
              />
              <span>{reviewCountDisplay}</span>
            </p>
          </div>
          <a href={reviewsCtaHref} class="btn btn-outline btn-lg request-estimate reviews-summary-cta" {...externalLinkAttrs(reviewsCtaHref)}>
            Book a Consultation
          </a>
        </div>
        <div class="testimonials-grid">
          {testimonials.map((t) => (
            <blockquote class="testimonial">
              <div class="review-brand review-brand-top">
                <img src={mediaUrl(asStr(t.avatarSrc))} alt={asStr(t.author)} class="review-avatar" />
                <div class="review-meta">
                  <strong>{asStr(t.author)}</strong>
                  <span class="review-time">{asStr(t.timeAgo)}</span>
                </div>
              </div>
              <img
                src={mediaUrl(asStr(reviewSummary?.starsImageSrc))}
                alt={asStr(reviewSummary?.starsImageAlt)}
                class="review-stars"
              />
              {t.quoteHtml ? (
                <p set:html={`&quot;${t.quoteHtml}&quot;`} />
              ) : (
                <p>&quot;{t.quote}&quot;</p>
              )}
              <div class="review-posted-on">
                <img
                  src={mediaUrl(asStr(reviewSummary?.googleIconSrc))}
                  alt={asStr(reviewSummary?.brandLabel)}
                  class="google-logo"
                />
                <span>{asStr(reviewsData?.postedOnLabel)}</span>
              </div>
            </blockquote>
          ))}
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <section id="contact" class="section contact footer-estimate">
      <div class="container">
        <div class="contact-wrapper">
          <div class="contact-info">
            <h2 class="section-title">{asStr(footerEstimate?.headline) || 'Need Gutter Help in Tampa?'}</h2>
            <p>{asStr(footerEstimate?.intro) || 'Start with a free consultation and get honest recommendations and transparent pricing from a team Tampa Bay homeowners trust.'}</p>
            <FooterContactInfo variant="estimate" phoneTel={phoneTel} phoneDisplay={phoneDisplay} email={email} address={address} addressHref={addressHref} />
          </div>
          <form class="contact-form" data-lead-form="reviews-footer" action={universalFormAction} method={universalFormMethod}>
            <div class="contact-form-grid">
              <div class="contact-form-field"><label for="contact-name">{asStr(universalFormFields?.nameLabel) || 'Name'} <span class="required-mark" aria-hidden="true">{universalRequiredIndicator}</span></label><input id="contact-name" name="name" type="text" required autocomplete="name" /></div>
              <div class="contact-form-field"><label for="contact-email">{asStr(universalFormFields?.emailLabel) || 'Email'} <span class="required-mark" aria-hidden="true">{universalRequiredIndicator}</span></label><input id="contact-email" name="email" type="email" required autocomplete="email" /></div>
              <div class="contact-form-field"><label for="contact-phone">{asStr(universalFormFields?.phoneLabel) || 'Phone'} <span class="required-mark" aria-hidden="true">{universalRequiredIndicator}</span></label><input id="contact-phone" name="phone" type="tel" required autocomplete="tel" /></div>
              <div class="contact-form-field"><label for="contact-location">{asStr(universalFormFields?.cityLabel) || 'City'}</label><input id="contact-location" name="location" type="text" autocomplete="address-level2" /></div>
              <div class="contact-form-field contact-form-field-full"><label for="contact-message">{asStr(universalFormFields?.projectDetailsLabel) || 'Project Details'}</label><textarea id="contact-message" name="message" rows="4"></textarea></div>
            </div>
            <SmsMarketingConsent checkboxId="reviews-footer-sms-consent" />
            <button type="submit" class="btn btn-primary btn-lg">Submit</button>
          </form>
        </div>
      </div>
    </section>
    <div class="container"><div class="footer-inner"><div class="footer-brand-block footer-col">{logoWhite ? <img src={mediaUrl(logoWhite)} alt={companyName} class="footer-logo" /> : null}<p class="footer-address">{descriptionShort}</p><div class="footer-social" aria-label={asStr(footerBrand?.socialAriaLabel)}>{footerBrand?.socialLinks?.map((s) => (<a href={asStr(s.href)} aria-label={asStr(s.ariaLabel)} {...externalLinkAttrs(asStr(s.href))}><FooterSocialIcon platform={asStr(s.platform)} /></a>))}</div></div>{footerColumns?.map((col) => (<div class="footer-col"><p class="footer-heading">{asStr(col.heading)}</p>{col.links?.length ? (<nav class="footer-links" aria-label={asStr(col.ariaLabel)}>{col.links.map((link) => (<a href={asStr(link.href)} {...externalLinkAttrs(asStr(link.href))}>{asStr(link.label)}</a>))}</nav>) : null}{isContactFooterColumnHeading(col.heading) ? <FooterContactInfo variant="footer-column" phoneTel={phoneTel} phoneDisplay={phoneDisplay} email={email} address={address} addressHref={addressHref} /> : null}{col.hoursHeading ? <p class="footer-heading footer-hours-heading">{asStr(col.hoursHeading)}</p> : null}{col.hoursText ? <FooterHoursRow hoursText={col.hoursText} /> : null}{(col.hoursHeading || col.hoursText) ? <FooterSmsDisclosure /> : null}</div>))}</div></div>
  </footer>

  <FooterFinancingDisclosure />

  <div class="footer-support"><div class="container footer-support-inner"><p>© <span id="year"></span> — <a href={copyrightHref} {...externalLinkAttrs(copyrightHref)}>{companyName}</a></p><nav aria-label={asStr(footerSupport?.ariaLabel)}>{footerSupport?.links?.map((link) => (<a href={asStr(link.href)} {...externalLinkAttrs(asStr(link.href))}>{asStr(link.label)}</a>))}</nav></div></div>
</BaseLayout>
